@using Compost.Core.Models
@model List<Compost.Core.Models.Meeting>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-success">
            <i class="fas fa-microphone"></i> Transcription
        </h2>
        <p class="text-muted">Record meetings and manage your transcripts.</p>
    </div>
    <a asp-action="Record" class="btn btn-primary">
        <i class="fas fa-plus-circle"></i> New Recording
    </a>
</div>

<div class="card mb-4">
    <div class="card-header bg-success text-white">
        <i class="fas fa-history"></i> Meeting History
    </div>
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Duration</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var meeting in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@meeting.Title</strong>
                                </td>
                                <td>
                                    <span class="badge bg-@(meeting.Status == MeetingStatus.Completed ? "success" : "info")">
                                        @meeting.Status
                                    </span>
                                </td>
                                <td>@meeting.StartedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                <td>@TimeSpan.FromSeconds(meeting.DurationSeconds).ToString(@"hh\:mm\:ss")</td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="Detail" asp-route-id="@meeting.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@meeting.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this meeting?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger ms-1">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-microphone-slash fa-4x text-muted mb-3"></i>
                
                @if (ViewBag.ShowMigrationNote == true)
                {
                    <h5>Active Transcriptions</h5>
                    <div class="alert alert-info d-inline-block">
                        <i class="fas fa-info-circle me-2"></i>
                        @ViewBag.Message
                    </div>
                    <p class="text-muted mt-3">
                        <a asp-action="Record" class="btn btn-outline-success">Start New Recording</a>
                        <span class="mx-2">or</span>
                        <a href="/Admin" class="btn btn-outline-primary">Run Database Migrations</a>
                    </p>
                }
                else
                {
                    <h5>No recordings yet</h5>
                    <p class="text-muted">Start a new recording to capture your first meeting transcript.</p>
                    <a asp-action="Record" class="btn btn-outline-success">Start Recording</a>
                }
            </div>
        }
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <i class="fas fa-lightbulb"></i> Transcription Tips
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <i class="fas fa-check text-success me-2"></i> Use a high-quality microphone for better accuracy.
                    </li>
                    <li class="list-group-item">
                        <i class="fas fa-check text-success me-2"></i> Speak clearly and avoid talking over each other.
                    </li>
                    <li class="list-group-item">
                        <i class="fas fa-check text-success me-2"></i> Use the "Project" setting to help the AI identify relevant keywords.
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <i class="fas fa-cog"></i> Speech Recognition Support
            </div>
            <div class="card-body">
                <p>The system currently uses browser-based speech recognition for stubs, with full <strong>Azure Speech Services</strong> integration planned for production.</p>
                <div class="alert alert-info py-2">
                    <i class="fas fa-info-circle me-2"></i> Supports 80+ languages and custom acoustic models.
                </div>
            </div>
        </div>
    </div>
</div>
