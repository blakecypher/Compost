@{
    var title = ViewBag.Title ?? nameof(Compost);
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Compost</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <style>
        /* Gruvbox Palette Definition */
        :root, [data-bs-theme="light"] {
            --gruv-bg: #f9f5d7;
            --gruv-bg-soft: #ebdbb2;
            --gruv-fg: #282828;
            --gruv-fg-alt: #3c3836;
            --gruv-red: #9d0006;
            --gruv-green: #79740e;
            --gruv-yellow: #b57614;
            --gruv-blue: #076678;
            --gruv-purple: #8f3f71;
            --gruv-aqua: #427b58;
            --gruv-orange: #af3a03;
            --gruv-gray: #665c54;

            /* Bootstrap Overrides */
            --bs-body-bg: var(--gruv-bg);
            --bs-body-color: var(--gruv-fg);
            --bs-primary: var(--gruv-green);
            --bs-secondary: var(--gruv-gray);
            --bs-success: var(--gruv-aqua);
            --bs-info: var(--gruv-blue);
            --bs-warning: var(--gruv-yellow);
            --bs-danger: var(--gruv-red);
            --bs-dark: var(--gruv-fg);
            --bs-light: var(--gruv-bg-soft);

            /* Custom Components */
            --sidebar-bg: var(--gruv-bg-soft);
            --card-bg: #fdf6e3;
            --border-color: #d5c4a1;

            /* Module Theme Colors */
            --theme-snippets: #ab3e53;
            --theme-patterns: #7c3aed;
        }

        [data-bs-theme="dark"] {
            --gruv-bg: #282828;
            --gruv-bg-soft: #32302f;
            --gruv-fg: #ebdbb2;
            --gruv-fg-alt: #d5c4a1;
            --gruv-red: #fb4934;
            --gruv-green: #b8bb26;
            --gruv-yellow: #fabd2f;
            --gruv-blue: #83a598;
            --gruv-purple: #d3869b;
            --gruv-aqua: #8ec07c;
            --gruv-orange: #fe8019;
            --gruv-gray: #a89984;

            /* Bootstrap Overrides */
            --bs-body-bg: var(--gruv-bg);
            --bs-body-color: var(--gruv-fg);
            --bs-primary: var(--gruv-green);
            --bs-secondary: var(--gruv-gray);
            --bs-success: var(--gruv-aqua);
            --bs-info: var(--gruv-blue);
            --bs-warning: var(--gruv-yellow);
            --bs-danger: var(--gruv-red);
            --bs-dark: var(--gruv-bg-soft);
            --bs-light: var(--gruv-fg);

            /* Custom Components */
            --sidebar-bg: var(--gruv-bg-soft);
            --card-bg: #3c3836;
            --border-color: #504945;

            /* Module Theme Colors - Dark */
            --theme-snippets: #9ca3af;
            --theme-patterns: #8b5cf6;
        }

        /* Global Styles */
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: var(--bs-body-bg) !important; color: var(--bs-body-color) !important; }
        
        .navbar { background-color: var(--gruv-green) !important; color: #fbf1c7 !important; }
        .navbar-brand, .nav-link { color: #fbf1c7 !important; }
        .navbar-toggler { border-color: rgba(251, 241, 199, 0.5); }
        .navbar-toggler-icon { filter: invert(90%); }

        .sidebar { background-color: var(--sidebar-bg) !important; border-right: 1px solid var(--border-color) !important; }
        .sidebar .nav-link { color: var(--bs-body-color); font-weight: 500; }
        
        /* Snippets - Slate with red tint */
        .sidebar .nav-link[href*="Snippets"]:hover { 
            background-color: rgba(171, 62, 83, 0.2) !important; 
            color: var(--theme-snippets) !important;
            font-weight: 600 !important;
        }
        .sidebar .nav-link[href*="Snippets"].active { 
            background-color: var(--theme-snippets) !important; 
            color: #fff !important;
            font-weight: 600 !important;
            box-shadow: 0 0 12px rgba(171, 62, 83, 0.5), inset 0 0 0 1px rgba(171, 62, 83, 0.4) !important;
        }
        
        /* Patterns - Purple */
        .sidebar .nav-link[href*="Patterns"]:hover { 
            background-color: rgba(124, 58, 237, 0.2) !important; 
            color: var(--theme-patterns) !important;
            font-weight: 600 !important;
        }
        .sidebar .nav-link[href*="Patterns"].active { 
            background-color: var(--theme-patterns) !important; 
            color: #fff !important;
            font-weight: 600 !important;
            box-shadow: 0 0 12px rgba(124, 58, 237, 0.5), inset 0 0 0 1px rgba(124, 58, 237, 0.4) !important;
        }
        
        .sidebar .menu-section { font-size: 0.7rem; letter-spacing: 0.05em; color: var(--gruv-gray); padding: 0.5rem 0.75rem 0.25rem; }

        .card { background-color: var(--card-bg); border: 1px solid var(--border-color); }
        .card-header { background-color: rgba(0,0,0,0.03); border-bottom: 1px solid var(--border-color); font-weight: bold; }
        .card-footer { border-top: 1px solid var(--border-color); background-color: rgba(0,0,0,0.03); }

        .btn-primary { background-color: var(--gruv-green); border-color: var(--gruv-green); color: #fbf1c7; }
        .btn-primary:hover { background-color: var(--gruv-aqua); border-color: var(--gruv-aqua); color: #282828; }
        
        .btn-outline-primary { color: var(--gruv-green); border-color: var(--gruv-green); }
        .btn-outline-primary:hover { background-color: var(--gruv-green); color: #fbf1c7; }

        /* Force overrides for bootstrap utilities */
        .bg-light { background-color: var(--gruv-bg-soft) !important; }
        .bg-white { background-color: var(--card-bg) !important; }
        .text-dark { color: var(--gruv-fg) !important; }
        .text-muted { color: var(--gruv-gray) !important; }
        .border { border-color: var(--border-color) !important; }
        
        .table { --bs-table-bg: transparent; --bs-table-color: var(--gruv-fg); --bs-table-border-color: var(--border-color); }
        .table-light { --bs-table-bg: var(--gruv-bg-soft); --bs-table-color: var(--gruv-fg); }
        
        /* Form Controls */
        [data-bs-theme="light"] .form-control {
            background-color: #fdf6e3;
            border-color: #d5c4a1;
            color: #282828;
        }
        
        [data-bs-theme="light"] .form-control:focus {
            background-color: #fdf6e3;
            border-color: var(--gruv-green);
            color: #282828;
            box-shadow: 0 0 0 0.2rem rgba(121, 116, 14, 0.25);
        }
        
        [data-bs-theme="light"] .form-select {
            background-color: #fdf6e3;
            border-color: #d5c4a1;
            color: #282828;
        }
        
        [data-bs-theme="light"] .form-select:focus {
            background-color: #fdf6e3;
            border-color: var(--gruv-green);
            color: #282828;
            box-shadow: 0 0 0 0.2rem rgba(121, 116, 14, 0.25);
        }
        
        /* Fix Monaco Editor Border in Dark Mode */
        [data-bs-theme="dark"] .monaco-editor { border-color: #504945 !important; }

        /* Module Theme Utilities */
        .bg-theme-snippets  { background-color: var(--theme-snippets) !important; }
        .bg-theme-patterns  { background-color: var(--theme-patterns) !important; }
        .text-theme-snippets  { color: #9ca3af !important; }
        .text-theme-patterns  { color: #8b5cf6 !important; }
        .text-on-theme-snippets, .text-on-theme-patterns { color: #fff !important; }
        
        .btn-theme-snippets { background-color: #9ca3af; border-color: #9ca3af; color: #fff; }
        .btn-theme-snippets:hover { filter: brightness(1.12); color: #fff; }
        .btn-theme-patterns { background-color: #8b5cf6; border-color: #8b5cf6; color: #fff; }
        .btn-theme-patterns:hover { filter: brightness(1.12); color: #fff; }
        
        /* Module Theme Utilities - ULTRA SPECIFIC */
        .container-fluid h1.text-theme-snippets,
        .container-fluid h1 i.text-theme-snippets,
        h1.text-theme-snippets,
        .text-theme-snippets {
            color: #f87171 !important;
        }
        .container-fluid h1.text-theme-patterns,
        h1.text-theme-patterns,
        .text-theme-patterns {
            color: #a855f7 !important;
        }
        
        .btn.btn-theme-snippets {
            background-color: #f87171 !important;
            border-color: #f87171 !important;
            color: #fff !important;
        }
        .btn.btn-theme-patterns {
            background-color: #a855f7 !important;
            border-color: #a855f7 !important;
            color: #fff !important;
        }
        
        /* Enhanced Card Styles */
        .card.snippet-enhanced-card {
            border-left: 4px solid #f87171 !important;
        }
        .card.pattern-enhanced-card {
            border-left: 4px solid #a855f7 !important;
        }
        .snippet-enhanced-card .card-header {
            background: linear-gradient(135deg, rgba(171,62,83,0.1) 0%, rgba(171,62,83,0.05) 100%);
            border-bottom: 1px solid rgba(171,62,83,0.2);
        }
        .snippet-header-background {
            background: linear-gradient(135deg, rgba(171,62,83,0.15) 0%, rgba(171,62,83,0.05) 100%) !important;
        }
        .snippet-icon {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: rgba(171,62,83,0.15);
        }
        
        .pattern-enhanced-card {
            border-left: 4px solid var(--theme-patterns);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .pattern-enhanced-card .card-header {
            background: linear-gradient(135deg, rgba(124,58,237,0.1) 0%, rgba(124,58,237,0.05) 100%);
            border-bottom: 1px solid rgba(124,58,237,0.2);
        }
        .pattern-header-background {
            background: linear-gradient(135deg, rgba(124,58,237,0.15) 0%, rgba(124,58,237,0.05) 100%) !important;
        }
        .pattern-icon {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: rgba(124,58,237,0.15);
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-body-tertiary">
    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="~/">
                <i class="fas fa-leaf me-2"></i>Compost
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link px-3 text-white-50" id="themeToggle" href="#" title="Toggle Dark/Light Mode">
                            <i class="fas fa-moon"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/"><i class="fas fa-home me-1"></i>Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/Admin"><i class="fas fa-cog me-1"></i>Admin</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Left Sidebar Menu -->
            <nav class="col-md-2 d-none d-md-block sidebar vh-100 border-end pt-3">
                <div class="sidebar-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item mb-2">
                            <a class="nav-link @(Context.Request.Path == "/" ? "active" : "")" href="~/">
                                <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item mt-2"><span class="menu-section">Workflow</span></li>
                        <li class="nav-item mb-2">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/List") ? "active" : "")" href="/Projects/List">
                                <i class="fas fa-folder-open me-2"></i>Projects
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/Projects/Create") ? "active" : "")" href="/Projects/Create">
                                <i class="fas fa-plus-circle me-2"></i>Create Context
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/MindMap") ? "active" : "")" href="/MindMap">
                                <i class="fas fa-brain me-2"></i>Mind Maps
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a class="nav-link @(Context.Request.Path.ToString().StartsWith("/Kanban") ? "active" : "")" href="/Kanban">
                                <i class="fas fa-columns me-2"></i>Kanban Board
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/TreeView") ? "active" : "")" href="/Contexts/TreeView">
                                <i class="fas fa-sitemap me-2"></i>Tree View
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/Transcription") ? "active" : "")" href="/Transcription">
                                <i class="fas fa-microphone me-2"></i>Transcription
                            </a>
                        </li>
                        <li class="nav-item mt-2"><span class="menu-section">Library</span></li>
                        <li class="nav-item mb-2">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/Snippets") ? "active" : "")" href="/Snippets">
                                <i class="fas fa-code me-2"></i>Snippets
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/Patterns") ? "active" : "")" href="/Patterns">
                                <i class="fas fa-project-diagram me-2"></i>Patterns
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-md-10 ms-sm-auto px-md-4 py-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- jQuery (Required for Validation) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Theme Toggle -->
    <script>
        const themeToggle = document.getElementById('themeToggle');
        const html = document.documentElement;
        
        const savedTheme = localStorage.getItem('theme') || 'light';
        html.setAttribute('data-bs-theme', savedTheme);
        if (themeToggle) updateToggleIcon(savedTheme);

        if (themeToggle) {
            themeToggle.addEventListener('click', (e) => {
                e.preventDefault();
                const currentTheme = html.getAttribute('data-bs-theme');
                const newTheme = currentTheme === 'light' ? 'dark' : 'light';
                
                html.setAttribute('data-bs-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                updateToggleIcon(newTheme);
            });
        }

        function updateToggleIcon(theme) {
            const icon = themeToggle?.querySelector('i');
            if (!icon) return;
            if (theme === 'dark') {
                icon.className = 'fas fa-sun';
            } else {
                icon.className = 'fas fa-moon';
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
