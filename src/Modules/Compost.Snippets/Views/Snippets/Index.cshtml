@using Compost.Snippets.Models
@using OrchardCore.ContentManagement
@model IEnumerable<ContentItem>

@{
    ViewData["Title"] = "Code Snippets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-secondary">
            <i class="fas fa-code"></i> Code Snippets
        </h2>
        <p class="text-muted">Repository for your reusable code components.</p>
    </div>
    <a asp-action="Create" class="btn btn-secondary">
        <i class="fas fa-plus"></i> Add Snippet
    </a>
</div>

<div class="card bg-light mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="input-group">
                <input type="text" name="query" class="form-control" placeholder="Search snippets by name, language, or content..." value="@ViewBag.SearchQuery">
                <button class="btn btn-outline-secondary" type="submit">
                    <i class="fas fa-search"></i> Search
                </button>
                @if (ViewBag.SearchQuery != null)
                {
                    <a asp-action="Index" class="btn btn-outline-danger">
                        <i class="fas fa-times"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var item in Model)
        {
            var snippet = item.As<CodeSnippetPart>();
            if (snippet == null) continue;

            string GetBaseColor(string lang) => lang?.ToLower() switch
            {
                "csharp" => "primary",
                "javascript" => "warning",
                "typescript" => "info",
                "python" => "success",
                "sql" => "secondary",
                "json" => "dark",
                "xml" => "danger",
                "html" => "danger",
                "css" => "info",
                _ => "secondary"
            };

            var baseColor = GetBaseColor(snippet.Language);
            var headerClass = $"bg-{baseColor} {(baseColor is "warning" or "info" ? "text-dark" : "text-white")}";
            var buttonClass = $"btn-outline-{baseColor}";
            var textColorClass = baseColor is "warning" or "info" ? "text-dark" : "text-white";
            
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header @headerClass d-flex justify-content-between align-items-center">
                        <span class="fw-bold"><i class="fas fa-code me-1"></i> @(snippet.Language?.ToUpper() ?? "TEXT")</span>
                        <div class="dropdown">
                            <button class="btn btn-link @textColorClass p-0" type="button" data-bs-toggle="dropdown" style="text-decoration: none;">
                                <i class="fas fa-ellipsis-v"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a asp-action="Detail" asp-route-id="@item.ContentItemId" class="dropdown-item"><i class="fas fa-eye me-2"></i>View</a></li>
                                <li><a asp-action="Edit" asp-route-id="@item.ContentItemId" class="dropdown-item"><i class="fas fa-edit me-2"></i>Edit</a></li>
                                <li><a asp-action="Delete" asp-route-id="@item.ContentItemId" class="dropdown-item text-danger" onclick="return confirm('Are you sure?');"><i class="fas fa-trash me-2"></i>Delete</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">
                            <a asp-action="Detail" asp-route-id="@item.ContentItemId" class="text-decoration-none text-dark">@item.DisplayText</a>
                        </h5>
                        <p class="card-text text-muted small">
                            @(snippet.Documentation?.Length > 100 ? snippet.Documentation[..100] + "..." : snippet.Documentation)
                        </p>
                        <div class="mt-2 mb-3">
                           @if(snippet.Tags != null)
                           {
                               @foreach(var tag in snippet.Tags.Take(3))
                               {
                                   <span class="badge bg-light text-dark border me-1">@tag</span>
                               }
                           }
                        </div>
                         <!-- Code preview with theme support -->
                        <div class="p-3 rounded snippet-code-preview" style="max-height: 200px; overflow: hidden; position: relative; border-left: 4px solid @(baseColor == "dark" ? "#6c757d" : $"var(--bs-{baseColor})"); background: var(--bs-body-bg);">
                            <pre class="m-0" style="background: transparent; padding: 0;"><code class="language-@snippet.Language" style="font-family: 'Fira Code', Consolas, monospace; font-size: 0.85rem; color: var(--bs-body-color);">@snippet.Code</code></pre>
                            <div class="position-absolute bottom-0 start-0 w-100 h-25 snippet-preview-gradient" style="background: linear-gradient(to bottom, transparent, var(--bs-body-bg));"></div>
                        </div>
                    </div>
                     <div class="card-footer border-0 d-flex justify-content-between align-items-center pt-0 pb-3" style="background: var(--bs-card-bg);">
                        <small class="text-muted">
                            <i class="fas fa-folder me-1"></i> @(snippet.Category ?? "Uncategorized")
                        </small>
                        <div class="d-flex gap-1">
                            <a asp-action="Detail" asp-route-id="@item.ContentItemId" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-action="Edit" asp-route-id="@item.ContentItemId" class="btn btn-sm @buttonClass">Edit</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-secondary text-center py-5">
        <i class="fas fa-code fa-3x mb-3"></i>
        <h4>No Snippets Yet</h4>
        <p>Start building your library by adding your first code snippet.</p>
        <a asp-action="Create" class="btn btn-primary mt-2">Create Snippet</a>
    </div>
}

<!-- Include Prism for syntax highlighting in the list view with theme support -->
<script>
    // Determine which Prism theme to load based on current theme
    var isDarkMode = document.documentElement.getAttribute('data-bs-theme') === 'dark';
    var prismTheme = isDarkMode ? 'prism-tomorrow.min.css' : 'prism.min.css';
    var link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/themes/' + prismTheme;
    document.head.appendChild(link);
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/prism.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/components/prism-csharp.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/components/prism-javascript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/components/prism-python.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/components/prism-sql.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/components/prism-json.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof Prism !== 'undefined') Prism.highlightAll();
    });
</script>
