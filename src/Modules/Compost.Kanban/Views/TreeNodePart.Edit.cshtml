@using Compost.Core.Models
@model Compost.Kanban.ViewModels.TreeNodePartViewModel

<div class="mb-3">
    <label asp-for="WorkContextId" class="form-label">Work Project ID</label>
    <input asp-for="WorkContextId" class="form-control" />
    <span class="hint">The unique ID of the project context this requirement belongs to.</span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Complexity" class="form-label">Complexity</label>
        <select asp-for="Complexity" class="form-select">
            @foreach (ComplexityLevel level in Enum.GetValues(typeof(ComplexityLevel)))
            {
                <option value="@level">@level.ToString()</option>
            }
        </select>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Priority" class="form-label">Priority</label>
        <select asp-for="Priority" class="form-select">
            @foreach (PriorityLevel level in Enum.GetValues(typeof(PriorityLevel)))
            {
                <option value="@level">@level.ToString()</option>
            }
        </select>
    </div>
</div>

<div class="mb-3">
    <label class="form-label">Acceptance Criteria</label>
    <div id="acceptance-criteria-container">
        @for (int i = 0; i < Model.AcceptanceCriteria.Count; i++)
        {
            <div class="input-group mb-2">
                <input name="AcceptanceCriteria[@i]" class="form-control" value="@Model.AcceptanceCriteria[i]" />
                <button type="button" class="btn btn-outline-danger remove-item"><i class="fas fa-times"></i></button>
            </div>
        }
    </div>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="add-acceptance-criterion">
        <i class="fas fa-plus"></i> Add Criterion
    </button>
</div>

<div class="mb-3">
    <label class="form-label">Technical Requirements</label>
    <div id="technical-requirements-container">
        @for (int i = 0; i < Model.TechnicalRequirements.Count; i++)
        {
            <div class="input-group mb-2">
                <input name="TechnicalRequirements[@i]" class="form-control" value="@Model.TechnicalRequirements[i]" />
                <button type="button" class="btn btn-outline-danger remove-item"><i class="fas fa-times"></i></button>
            </div>
        }
    </div>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="add-technical-requirement">
        <i class="fas fa-plus"></i> Add Requirement
    </button>
</div>

<div class="mb-3 form-check">
    <input asp-for="IsPromotedToKanban" type="checkbox" class="form-check-input" readonly disabled />
    <label asp-for="IsPromotedToKanban" class="form-check-label">Is Promoted to Kanban</label>
    <span class="hint d-block">This status is updated automatically when you promote this node.</span>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        setupDynamicList('acceptance-criteria-container', 'AcceptanceCriteria', 'add-acceptance-criterion');
        setupDynamicList('technical-requirements-container', 'TechnicalRequirements', 'add-technical-requirement');
        
        function setupDynamicList(containerId, fieldName, addBtnId) {
            const container = document.getElementById(containerId);
            const addBtn = document.getElementById(addBtnId);
            
            addBtn.addEventListener('click', function() {
                const index = container.querySelectorAll('.input-group').length;
                const div = document.createElement('div');
                div.className = 'input-group mb-2';
                div.innerHTML = `
                    <input name="${fieldName}[${index}]" class="form-control" />
                    <button type="button" class="btn btn-outline-danger remove-item"><i class="fas fa-times"></i></button>
                `;
                container.appendChild(div);
                setupRemoveBtn(div.querySelector('.remove-item'));
            });
            
            container.querySelectorAll('.remove-item').forEach(setupRemoveBtn);
        }
        
        function setupRemoveBtn(btn) {
            btn.addEventListener('click', function() {
                this.closest('.input-group').remove();
                // We should technically re-index here if using standard model binding, 
                // but Orchard's part update usually handles this if we use a specific approach.
                // For simplicity in this stub, we'll leave it as is.
            });
        }
    });
</script>
