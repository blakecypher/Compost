@{
    var title = ViewBag.Title ?? nameof(Compost);
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Prevent FOUC - set background color before CSS loads -->
    <style>
        html { background-color: #282828; }
        body { background-color: #282828 !important; visibility: hidden; }
        body.css-loaded { visibility: visible; }
    </style>
    
    <title>@title - Compost</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        /* Sidebar Transitions & Premium Animations */
        .sidebar { 
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.3s ease; 
            width: 260px;
            overflow-x: hidden;
            background-color: var(--bs-body-bg) !important; 
            border-right: 1px solid var(--bs-border-color) !important;
            z-index: 100;
        }
        
        .sidebar.collapsed {
            width: 72px;
        }

        .sidebar .nav-link { 
            color: var(--bs-body-color); 
            font-weight: 500; 
            white-space: nowrap;
            display: flex;
            align-items: center;
            overflow: hidden;
            padding: 0.8rem 1.25rem;
            border-radius: 0;
            transition: all 0.2s ease;
        }

        .sidebar .nav-link i {
            min-width: 24px;
            font-size: 1.1rem;
            margin-right: 1rem;
        }

        .sidebar .nav-link span {
            opacity: 1;
            transition: opacity 0.2s ease;
        }

        .sidebar.collapsed .nav-link span,
        .sidebar.collapsed .menu-section {
            opacity: 0;
            pointer-events: none;
        }

        .sidebar.collapsed .nav-link i {
            margin-right: 2rem;
        }

        /* Shift main content smoothly */
        main {
            transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            flex-grow: 1;
            min-height: calc(100vh - 56px);
            min-width: 0; /* Critical for flexbox content containment */
            overflow-x: hidden;
        }

        /* Toggle Button Styling */
        #sidebarToggle {
            cursor: pointer;
            padding: 0.5rem;
            color: #fff;
            border: none;
            background: transparent;
            font-size: 1.2rem;
            margin-right: 0.5rem;
            transition: transform 0.3s ease;
        }
        
        #sidebarToggle:hover {
            opacity: 0.8;
        }

        .sidebar-sticky {
            position: sticky;
            top: 0;
            height: calc(100vh - 56px);
            padding-top: .5rem;
            overflow-x: hidden;
            overflow-y: auto;
        }

        .nav-link:hover { background-color: rgba(0, 0, 0, 0.06); border-radius: 0.25rem; }
        .sidebar .menu-section { 
            font-size: 0.65rem; 
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.1em; 
            padding: 1.5rem 1.25rem 0.5rem;
            white-space: nowrap;
            transition: opacity 0.2s ease;
        }
        [data-bs-theme="light"] .sidebar .menu-section { color: #495057; }
        [data-bs-theme="dark"] .sidebar .menu-section { color: #adb5bd; }
        [data-bs-theme="light"] .text-dark { color: #212529 !important; }
        /* Module Theme Variables - Light */
        :root, [data-bs-theme="light"] {
            --theme-dashboard: #198754;
            --theme-contexts: #6629d9;
            --theme-mindmaps: #ff6b35;
            --theme-kanban: #ffc107;
            --theme-transcription: #68a073;
            --theme-snippets: #943a3a;
            --theme-patterns: #6629d9;
        }
        /* Module Theme Variables - Dark */
        [data-bs-theme="dark"] {
            --theme-dashboard: #198754;
            --theme-contexts: #6629d9;
            --theme-mindmaps: #ff6b35;
            --theme-kanban: #ffc107;
            --theme-transcription: #68a073;
            --theme-snippets: #943a3a;
            --theme-patterns: #6629d9;
        }
        /* Module Theme Utilities */
        .bg-theme-dashboard    { background-color: var(--theme-dashboard) !important; }
        .bg-theme-contexts     { background-color: var(--theme-contexts) !important; }
        .bg-theme-mindmaps     { background-color: var(--theme-mindmaps) !important; }
        .bg-theme-kanban       { background-color: var(--theme-kanban) !important; }
        .bg-theme-transcription { background-color: var(--theme-transcription) !important; }
        .bg-theme-snippets     { background-color: var(--theme-snippets) !important; }
        .bg-theme-patterns     { background-color: var(--theme-patterns) !important; }
        .text-on-theme-dashboard, .text-on-theme-contexts, .text-on-theme-mindmaps,
        .text-on-theme-transcription, .text-on-theme-snippets, .text-on-theme-patterns { color: #fff !important; }
        .text-on-theme-kanban { color: #212529 !important; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-body-tertiary">
    <script>document.body.classList.add('css-loaded');</script>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm">
        <div class="container-fluid">
            <div class="d-flex align-items-center">
                <button id="sidebarToggle" title="Toggle Sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <a class="navbar-brand fw-bold" href="~/"><i class="fas fa-leaf me-2"></i>Compost</a>
            </div>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link px-3 text-white-50" id="themeToggle" href="#" title="Toggle Dark/Light Mode"><i class="fas fa-moon"></i></a>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="~/"><i class="fas fa-home me-1"></i>Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="~/Admin"><i class="fas fa-cog me-1"></i>Admin</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid p-0">
        <div class="d-flex">
            <nav id="sidebar" class="sidebar flex-shrink-0 pt-3">
                <div class="sidebar-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path == "/" ? "active bg-theme-dashboard text-on-theme-dashboard rounded" : "text-dark")" href="~/">
                                <i class="fas fa-tachometer-alt"></i><span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item"><span class="menu-section">Workflow</span></li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/Contexts") ? "active bg-theme-contexts text-on-theme-contexts rounded" : "text-dark")" href="/Projects/List">
                                <i class="fas fa-folder-open"></i><span>Projects</span>
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/Transcription") ? "active bg-theme-transcription text-on-theme-transcription rounded" : "text-dark")" href="/Transcription">
                                <i class="fas fa-microphone"></i><span>Transcription</span>
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/MindMap") ? "active bg-theme-mindmaps text-on-theme-mindmaps rounded" : "text-dark")" href="/MindMap">
                                <i class="fas fa-brain"></i><span>Mind Maps</span>
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().StartsWith("/Kanban") ? "active bg-theme-kanban text-on-theme-kanban rounded" : "text-dark")" href="/Kanban">
                                <i class="fas fa-columns"></i><span>Kanban Board</span>
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/GitDashboard") ? "active bg-primary text-white rounded" : "text-dark")" href="/Projects/GitDashboard">
                                <i class="fab fa-git-alt"></i><span>Git</span>
                            </a>
                        </li>
                        <li class="nav-item"><span class="menu-section">Library</span></li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/Snippets") ? "active bg-theme-snippets text-on-theme-snippets rounded" : "text-dark")" href="/Snippets">
                                <i class="fas fa-code"></i><span>Snippets</span>
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/Patterns") ? "active bg-theme-patterns text-on-theme-patterns rounded" : "text-dark")" href="/Patterns">
                                <i class="fas fa-project-diagram"></i><span>Patterns</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <main id="main-content" class="px-md-4 py-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const themeToggle = document.getElementById('themeToggle');
        const html = document.documentElement;
        
        const savedTheme = localStorage.getItem('theme') || 'light';
        html.setAttribute('data-bs-theme', savedTheme);
        if (themeToggle) {
            themeToggle.querySelector('i').className = savedTheme === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
            themeToggle.addEventListener('click', function(e) {
                e.preventDefault();
                const t = html.getAttribute('data-bs-theme') === 'light' ? 'dark' : 'light';
                html.setAttribute('data-bs-theme', t);
                localStorage.setItem('theme', t);
                themeToggle.querySelector('i').className = t === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
            });
        }

        const sidebar = document.getElementById('sidebar');
        const sidebarToggle = document.getElementById('sidebarToggle');
        const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
        if (isCollapsed) sidebar.classList.add('collapsed');

        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', () => {
                sidebar.classList.toggle('collapsed');
                localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
                window.dispatchEvent(new Event('resize'));
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
