<script>
    // Force dark mode border colors on project cards
    (function forceDarkModeBorders() {
        function applyDarkBorders() {
            const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            const cards = document.querySelectorAll('.project-card, .project-enhanced-card, .border-theme-contexts');
            cards.forEach(card => {
                let style = card.getAttribute('style') || '';
                // Remove existing border styles
                style = style.replace(/border-top:\s*[^;]+;?/gi, '');
                style = style.replace(/border-left:\s*[^;]+;?/gi, '');
                style = style.replace(/border-right:\s*[^;]+;?/gi, '');
                style = style.replace(/border-bottom:\s*[^;]+;?/gi, '');
                if (isDark) {
                    style += ' border-top: 5px solid var(--theme-contexts) !important;';
                    style += ' border-left: 1px solid #444444 !important;';
                    style += ' border-right: 1px solid #444444 !important;';
                    style += ' border-bottom: 1px solid #444444 !important;';
                } else {
                    style += ' border-top: 5px solid var(--theme-contexts);';
                }
                card.setAttribute('style', style.trim());
            });
        }
        
        // Apply on load
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', applyDarkBorders);
        } else {
            applyDarkBorders();
        }
        
        // Apply after short delays
        setTimeout(applyDarkBorders, 100);
        setTimeout(applyDarkBorders, 500);
        setTimeout(applyDarkBorders, 1000);
        setTimeout(applyDarkBorders, 2000);
        
        // Watch for theme changes
        const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.attributeName === 'data-bs-theme') {
                    applyDarkBorders();
                }
            });
        });
        
        observer.observe(document.documentElement, { attributes: true });
    })();
</script>

<script>
    function copyProjectLink(projectId) {
        const url = window.location.origin + '/Project/TreeView#' + projectId;
        navigator.clipboard.writeText(url).then(() => {
            // Show success feedback
            const button = event.target.closest('button');
            const originalHtml = button.innerHTML;
            button.innerHTML = '<i class="fas fa-check"></i>';
            button.classList.add('btn-success');
            button.classList.remove('btn-outline-theme-contexts');
            
            setTimeout(() => {
                button.innerHTML = originalHtml;
                button.classList.remove('btn-success');
                button.classList.add('btn-outline-theme-contexts');
            }, 2000);
        });
    }
    
    // Copy project to sessionStorage for cross-module paste
    function copyProjectToSession(projectId, name, description, tags) {
        const item = {
            type: 'Project',
            id: projectId,
            name: name,
            description: description,
            tags: tags,
            copiedAt: new Date().toISOString()
        };
        sessionStorage.setItem('copiedItem', JSON.stringify(item));
        showToast('Item copied! You can now paste it into Patterns or Snippets.', 'success');
    }
    
    // Toast notification
    function showToast(message, type = 'info') {
        const toast = document.createElement('div');
        toast.className = `toast-notification toast-${type}`;
        toast.innerHTML = `
            <i class="fas fa-${type === 'success' ? 'check-circle' : 'info-circle'}"></i>
            <span>${message}</span>
        `;
        document.body.appendChild(toast);
        setTimeout(() => toast.classList.add('show'), 10);
        setTimeout(() => {
            toast.classList.remove('show');
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }
    
    function importSampleProjects() {
        // This could be expanded to actually import sample projects
        alert('Sample project import would be implemented here. For now, click "Create Project" to get started.');
    }
    
    function changeView(viewType) {
        const boardView = document.getElementById('projectsBoard');
        const treeView = document.getElementById('treeView');
        const boardBtn = document.querySelector('[onclick="changeView(\'board\')"]');
        const treeBtn = document.querySelector('[onclick="changeView(\'tree\')"]');
        
        if (viewType === 'board') {
            boardView.style.display = 'block';
            treeView.style.display = 'none';
            boardBtn.classList.add('active');
            treeBtn.classList.remove('active');
        } else {
            boardView.style.display = 'none';
            treeView.style.display = 'block';
            boardBtn.classList.remove('active');
            treeBtn.classList.add('active');
        }
    }
</script>
