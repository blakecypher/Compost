@using Compost.Core.Models
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.DependencyInjection
@model List<Compost.Core.Models.Project>

@{
    ViewBag.Title = "Projects";

    var rootProjects = Model.Where(p => string.IsNullOrEmpty(p.ParentProjectId)).OrderBy(p => p.DisplayOrder).ToList();
    var allProjects = Model.OrderBy(p => p.DisplayOrder).ToList();
}

<style>
    /* Card header styling to match MindMap */
    [data-bs-theme="dark"] .project-card-header {
        background-color: #2d2d2d !important;
        color: #d4d4d8 !important;
    }
    [data-bs-theme="light"] .project-card-header {
        background-color: #f8f9fa !important;
        color: #212529 !important;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="text-theme-contexts">
            <i class="fas fa-th-large me-2"></i>Projects
        </h1>
        <p class="text-muted">Manage your projects in a board view. Drag and drop to organize your work.</p>
    </div>
    <a asp-action="Create" asp-controller="Project" class="btn btn-outline-theme-contexts">
        <i class="fas fa-plus me-2"></i>Create Project
    </a>
</div>

<!-- Search and Filter Bar -->
<div class="card bg-light mb-4">
    <div class="card-body">
        <form asp-action="TreeView" method="get">
            <div class="row g-3">
                <div class="col-md-6">
                    <input type="text" name="query" class="form-control" placeholder="Search project names, descriptions..." value="@ViewBag.SearchQuery">
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select" id="statusFilter" onchange="filterByStatus()">
                        <option value="">All Statuses</option>
                        <option value="To Do">To Do</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Done">Done</option>
                        <option value="Blocked">Blocked</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="d-flex gap-2">
                        <button id="search-btn" class="btn flex-fill" type="submit" style="color: #8b5cf6 !important; border: 1px solid #8b5cf6 !important; background-color: transparent !important;">
                            <i class="fas fa-search"></i> Search
                        </button>
                        @if (ViewBag.SearchQuery != null)
                        {
                            <a asp-action="TreeView" class="btn btn-outline-theme-contexts" style="color: #8b5cf6 !important; border-color: #8b5cf6 !important; background-color: transparent !important;">
                                <i class="fas fa-times"></i> Clear
                            </a>
                        }
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="d-flex gap-2 align-items-center mb-4">
    <div class="btn-group">
        <button class="btn btn-outline-theme-contexts btn-sm" onclick="sortProjects('name')" title="Sort by Name">
            <i class="fas fa-sort-alpha-down"></i>
        </button>
        <button class="btn btn-outline-theme-contexts btn-sm" onclick="sortProjects('date')" title="Sort by Date">
            <i class="fas fa-sort-numeric-down"></i>
        </button>
    </div>
    <div class="btn-group">
        <button class="btn btn-outline-theme-contexts btn-sm active" onclick="changeView('board')" title="Board View">
            <i class="fas fa-th"></i>
        </button>
        <button class="btn btn-outline-theme-contexts btn-sm" onclick="changeView('tree')" title="Tree View">
            <i class="fas fa-sitemap"></i>
        </button>
    </div>
</div>

<!-- Projects Board -->
<div class="projects-board" id="projectsBoard">
    @if (allProjects.Any())
    {
        <div class="row g-4">
            @foreach (var project in allProjects)
            {
                var isActive = project.IsActive;
                var hasChildren = Model.Any(p => p.ParentProjectId == project.Id);
                var childCount = Model.Count(p => p.ParentProjectId == project.Id);
                
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="project-card card border-theme-contexts shadow-sm h-100 project-enhanced-card" 
                         data-project-id="@project.Id" 
                         data-parent-id="@project.ParentProjectId"
                         data-workflow-status="@project.Status"
                         data-is-active="@(isActive ? "true" : "false")"
                         data-name="@project.Name.ToLower()"
                         data-description="@(project.Description?.ToLower() ?? "")">
                        
                        <!-- Project Header -->
                        <div class="project-header card-header project-card-header border-theme-contexts d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="project-icon me-2">
                                    <i class="fas fa-folder text-theme-contexts"></i>
                                </div>
                                <div>
                                    <span class="badge bg-theme-contexts text-on-theme-contexts small">
                                        @(string.IsNullOrEmpty(project.ParentProjectId) ? "Root" : "Child")
                                    </span>
                                </div>
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-link text-muted" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="/Compost.Contexts/Project/Edit/@project.Id">
                                            <i class="fas fa-edit me-2"></i>Edit
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Compost.Contexts/Project/Create?parentId=@project.Id">
                                            <i class="fas fa-plus me-2"></i>Add Child
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <button type="button" class="dropdown-item" onclick="copyProjectToSession('@project.Id', '@project.Name.Replace("'", "\\'")', '@(project.Description?.Replace("'", "\\'") ?? "")', '@(project.Tags != null ? string.Join(",", project.Tags) : "")')">
                                            <i class="fas fa-copy me-2 text-info"></i>Copy Item
                                        </button>
                                    </li>
                                    @if (!isActive)
                                    {
                                        <li>
                                            <form action="/Compost.Contexts/Project/Switch/@project.Id" method="post" style="display:inline;">
                                            @{
                                                var antiforgery2 = ViewContext.HttpContext.RequestServices.GetService<IAntiforgery>();
                                                var tokens2 = antiforgery2?.GetAndStoreTokens(ViewContext.HttpContext);
                                                var tokenValue2 = tokens2?.RequestToken ?? "";
                                            }
                                            <input type="hidden" name="__RequestVerificationToken" value="@tokenValue2" />
                                                <button type="submit" class="dropdown-item">
                                                    <i class="fas fa-play me-2"></i>Activate
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    @if (project.CurrentSessionStartedAt.HasValue)
                                    {
                                        <li>
                                            <form action="/Compost.Contexts/Project/EndSession/@project.Id" method="post" style="display:inline;">
                                            @{
                                                var antiforgery3 = ViewContext.HttpContext.RequestServices.GetService<IAntiforgery>();
                                                var tokens3 = antiforgery3?.GetAndStoreTokens(ViewContext.HttpContext);
                                                var tokenValue3 = tokens3?.RequestToken ?? "";
                                            }
                                            <input type="hidden" name="__RequestVerificationToken" value="@tokenValue3" />
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="fas fa-stop me-2"></i>End Session
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <form action="/Compost.Contexts/Project/StartSession/@project.Id" method="post" style="display:inline;">
                                            @{
                                                var antiforgery4 = ViewContext.HttpContext.RequestServices.GetService<IAntiforgery>();
                                                var tokens4 = antiforgery4?.GetAndStoreTokens(ViewContext.HttpContext);
                                                var tokenValue4 = tokens4?.RequestToken ?? "";
                                            }
                                            <input type="hidden" name="__RequestVerificationToken" value="@tokenValue4" />
                                                <button type="submit" class="dropdown-item text-success">
                                                    <i class="fas fa-clock me-2"></i>Start Session
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <!-- Project Body -->
                        <div class="project-body card-body">
                            <h5 class="project-title fw-bold text-theme-contexts mb-2">@project.Name</h5>
                            
                            <!-- Status and Branch Info -->
                            <div class="mb-3">
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    @if (isActive)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-play me-1"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-pause me-1"></i>Inactive
                                        </span>
                                    }
                                    
                                    @if (project.TotalTimeSpentSeconds > 0 || project.CurrentSessionStartedAt.HasValue)
                                    {
                                        var totalSeconds = project.TotalTimeSpentSeconds;
                                        if (project.CurrentSessionStartedAt.HasValue)
                                        {
                                            totalSeconds += (long)(DateTime.UtcNow - project.CurrentSessionStartedAt.Value).TotalSeconds;
                                        }
                                        var timeSpan = TimeSpan.FromSeconds(totalSeconds);
                                        <span class="badge bg-dark" title="Total time spent">
                                            <i class="fas fa-clock me-1"></i>@($"{timeSpan.Hours}h {timeSpan.Minutes}m")
                                        </span>
                                    }
                                    
                                    @{
                                        var statusClass = project.Status switch
                                        {
                                            "To Do" => "bg-warning text-dark",
                                            "In Progress" => "bg-info",
                                            "Done" => "bg-success",
                                            "Blocked" => "bg-danger",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="badge @statusClass">
                                        <i class="fas fa-tasks me-1"></i>@project.Status
                                    </span>
                                    
                                    @if (hasChildren)
                                    {
                                        <span class="badge bg-info">
                                            <i class="fas fa-sitemap me-1"></i>@childCount child@(childCount != 1 ? "ren" : "")
                                        </span>
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(project.CurrentBranch))
                                    {
                                        <span class="badge bg-dark text-white">
                                            <i class="fas fa-code-branch me-1"></i>@project.CurrentBranch
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Description -->
                            @if (!string.IsNullOrEmpty(project.Description))
                            {
                                <div class="mb-3">
                                    <h6 class="text-muted small text-uppercase mb-2">Description</h6>
                                    <p class="project-description text-muted small">
                                        @(project.Description.Length > 120 ? project.Description[..120] + "..." : project.Description)
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="mb-3">
                                    <p class="project-description text-muted small italic">No description provided</p>
                                </div>
                            }

                            <!-- Tags -->
                            @if (project.Tags != null && project.Tags.Any())
                            {
                                <div class="project-tags mb-3">
                                    <h6 class="text-muted small text-uppercase mb-2">Tags</h6>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var tag in project.Tags.Take(4))
                                        {
                                            <span class="badge bg-light text-dark border small">@tag</span>
                                        }
                                        @if (project.Tags.Count > 4)
                                        {
                                            <span class="badge bg-light text-dark border small">+@(project.Tags.Count - 4)</span>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Project Metadata -->
                            <div class="project-metadata mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="fas fa-folder-tree me-1"></i>
                                        @if (string.IsNullOrEmpty(project.ParentProjectId))
                                        {
                                            <span>Root Project</span>
                                        }
                                        else
                                        {
                                            var parent = Model.FirstOrDefault(p => p.Id == project.ParentProjectId);
                                            <span>Child of @(parent?.Name ?? "Unknown")</span>
                                        }
                                    </small>
                                    <small class="text-muted">
                                        <i class="fas fa-sort me-1"></i>Order: @project.DisplayOrder
                                    </small>
                                </div>
                            </div>

                        </div>

                        <div class="card-footer bg-transparent" style="border-top: 1px solid var(--theme-contexts);">
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-theme-contexts flex-fill" onclick="viewProjectDetails('@project.Id')">
                                    <i class="fas fa-eye me-1"></i>View
                                </button>
                                @if (hasChildren)
                                {
                                    <button class="btn btn-sm btn-outline-theme-contexts" onclick="toggleChildren('@project.Id')">
                                        <i class="fas fa-sitemap me-1"></i>Children
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-theme-contexts" onclick="copyProjectLink('@project.Id')">
                                    <i class="fas fa-share"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="col-12">
            <div class="card"><div class="card-body text-center py-5">
                <i class="fas fa-folder-open fa-3x mb-3"></i>
                <h4>No Projects Yet</h4>
                <p class="mb-3">Create your first project to start organizing your work.</p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Create" asp-controller="Project" class="btn btn-theme-contexts">
                        <i class="fas fa-plus me-1"></i> Create Project
                    </a>
                    <button class="btn btn-outline-theme-contexts" onclick="importSampleProjects()" style="color: #8b5cf6 !important; border-color: #8b5cf6 !important; background-color: transparent !important;">
                        <i class="fas fa-download me-1"></i> Import Sample Projects
                    </button>
                </div>
            </div>
        </div>
    </div>
    }
</div>

<!-- Tree View (Hidden by default) -->
<div class="tree-container p-3 bg-light rounded" id="treeView" style="display: none;">
    
    @if (rootProjects.Any())
    {
        @foreach (var project in rootProjects)
        {
            @RenderTreeNode(project, 0)
        }
    }
    else
    {
        <div class="text-center text-muted py-5">
            <i class="fas fa-tree fa-3x mb-3"></i>
            <p>No projects yet. <a asp-action="Create" asp-controller="Project">Create your first project</a> to get started.</p>
        </div>
    }
</div>

@functions {

    private IHtmlContent RenderTreeNode(Project project, int level)
    {
        var children = Model.Where(c => c.ParentProjectId == project.Id).OrderBy(c => c.DisplayOrder).ToList();
        var hasChildren = children.Any();
        var isActive = project.IsActive;
        
        var content = new HtmlContentBuilder();
        
        // Start tree node div
        content.AppendHtml($"<div class=\"tree-node {(hasChildren ? "has-children" : "")} {(isActive ? "active-context" : "")}\" data-context-id=\"{project.Id}\" data-parent-id=\"{project.ParentProjectId}\" style=\"margin-left: {level * 30}px\">");
        
        // Start content div
        content.AppendHtml($"<div class=\"tree-node-content d-flex align-items-center p-2 border rounded mb-2\" draggable=\"true\" ondragstart=\"dragStart(event, '{project.Id}')\" ondragover=\"dragOver(event)\" ondrop=\"dragDrop(event, '{project.Id}')\" ondragleave=\"dragLeave(event)\">");
        
        // Toggle button or spacer
        if (hasChildren)
        {
            content.AppendHtml($"<button type=\"button\" class=\"btn btn-sm btn-link p-0 me-2\" onclick=\"toggleNode('{project.Id}')\" style=\"width: 24px;\"><i class=\"fas fa-chevron-down\" id=\"icon-{project.Id}\"></i></button>");
        }
        else
        {
            content.AppendHtml("<span style='width: 24px;'></span>");
        }
        
        // Main content
        content.AppendHtml("<div class=\"flex-grow-1\">");
        content.AppendHtml("<div class=\"d-flex align-items-center\">");
        
        if (isActive)
        {
            content.AppendHtml("<span class=\"badge bg-success me-2\">Active</span>");
        }
        
        content.AppendHtml($"<strong>{project.Name}</strong>");
        
        if (!string.IsNullOrEmpty(project.CurrentBranch))
        {
            content.AppendHtml($"<span class=\"badge bg-info ms-2\">{project.CurrentBranch}</span>");
        }
        
        content.AppendHtml("</div>");
        
        if (!string.IsNullOrEmpty(project.Description))
        {
            content.AppendHtml($"<small class=\"text-muted d-block\">{project.Description}</small>");
        }
        
        content.AppendHtml("<div class=\"mt-1\">");
        
        foreach (var tag in project.Tags?.Take(3) ?? new List<string>())
        {
            content.AppendHtml($"<span class=\"badge bg-light text-dark me-1\">{tag}</span>");
        }
        
        if ((project.Tags?.Count ?? 0) > 3)
        {
            if (project.Tags != null) content.AppendHtml($"<span class=\"badge bg-light text-dark\">+{project.Tags.Count - 3}</span>");
        }
        
        content.AppendHtml("</div></div>");
        
        // Action buttons
        content.AppendHtml("<div class=\"btn-group ms-2\">");
        content.AppendHtml($"<a href=\"/Compost.Contexts/Project/Edit/{project.Id}\" class=\"btn btn-sm btn-outline-primary\" title=\"Edit\"><i class=\"fas fa-edit\"></i></a>");
        
        if (!isActive)
        {
            var tokens = ViewContext.HttpContext.RequestServices.GetService<IAntiforgery>()?.GetAndStoreTokens(ViewContext.HttpContext);
            var tokenValue = tokens?.RequestToken ?? "";
            var formHtml = $"<form action=\"/Compost.Contexts/Project/Switch/{project.Id}\" method=\"post\" style=\"display:inline;\"><input type=\"hidden\" name=\"__RequestVerificationToken\" value=\"{tokenValue}\" /><button type=\"submit\" class=\"btn btn-sm btn-outline-success\" title=\"Activate\"><i class=\"fas fa-play\"></i></button></form>";
            content.AppendHtml(formHtml);
        }
        
        content.AppendHtml($"<a href=\"/Compost.Contexts/Project/Create?parentId={project.Id}\" class=\"btn btn-sm btn-outline-secondary\" title=\"Add Child\"><i class=\"fas fa-plus\"></i></a>");
        content.AppendHtml("</div></div>");
        
        // Children
        if (hasChildren)
        {
            content.AppendHtml($"<div class=\"tree-children\" id=\"children-{project.Id}\">");
            foreach (var child in children)
            {
                content.AppendHtml(RenderTreeNode(child, level + 1));
            }
            content.AppendHtml("</div>");
        }
        
        // End tree node div
        content.AppendHtml("</div>");
        
        return content;
    }
}

@section Scripts {
    <script>
        // IMMEDIATE execution - fix buttons right now
        (function fixButtons() {
            const allButtons = document.querySelectorAll('button, a.btn');
            allButtons.forEach(btn => {
                const text = btn.textContent || '';
                const hasSearch = text.includes('Search');
                const hasImport = text.includes('Import');
                const hasClear = text.includes('Clear');
                const hasBoard = btn.getAttribute('onclick')?.includes('changeView');
                
                if (hasSearch || hasImport || hasClear || hasBoard) {
                    btn.classList.remove('btn-outline-secondary', 'btn-outline-primary', 'btn-outline-danger');
                    btn.classList.add('btn-outline-theme-contexts');
                    btn.style.cssText = 'color: #8b5cf6 !important; border: 1px solid #8b5cf6 !important; background-color: transparent !important;';
                }
            });
            // Run again after a short delay to catch any dynamically added buttons
            setTimeout(fixButtons, 100);
            setTimeout(fixButtons, 500);
        })();
        // Tree View Functions
        let draggedId = null;
        
        function dragStart(event, id) {
            draggedId = id;
            event.dataTransfer.setData('text/plain', id);
            event.dataTransfer.effectAllowed = 'move';
        }
        
        function dragOver(event) {
            event.preventDefault();
            event.dataTransfer.dropEffect = 'move';
            
            const target = event.currentTarget;
            if (target.classList.contains('tree-node-content')) {
                target.classList.add('drag-over');
            }
        }
        
        function dragLeave(event) {
            const target = event.currentTarget;
            target.classList.remove('drag-over');
        }
        
        async function dragDrop(event, targetId) {
            event.preventDefault();
            event.stopPropagation();
            
            const target = event.currentTarget;
            target.classList.remove('drag-over');
            
            if (draggedId === targetId) return;
            
            if (isDescendant(draggedId, targetId)) {
                alert('Cannot move a parent context into its own child');
                return;
            }
            
            await updateParent(draggedId, targetId);
        }
        
        async function dragDropRoot(event) {
            event.preventDefault();
            
            const target = event.target.closest('.tree-node-content');
            if (target) return;
            
            await updateParent(draggedId, null);
        }
        
        function isDescendant(parentId, childId) {
            const parent = document.querySelector(`[data-context-id="${parentId}"]`);
            if (!parent) return false;
            
            const children = parent.querySelectorAll('.tree-node');
            return Array.from(children).some(child => 
                child.getAttribute('data-context-id') === childId
            );
        }
        
        async function updateParent(projectId, parentId) {
            try {
                const formData = new FormData();
                formData.append('projectId', projectId);
                if (parentId) {
                    formData.append('parentId', parentId);
                }
                
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    formData.append('__RequestVerificationToken', token.value);
                }
                
                const response = await fetch('/Compost.Contexts/Project/UpdateParent', {
                    method: 'POST',
                    body: formData
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                const result = await response.json();
                
                if (result.success) {
                    location.reload();
                } else {
                    alert('Failed to update: ' + result.error);
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }
        
        function toggleNode(id) {
            const children = document.getElementById('children-' + id);
            const icon = document.getElementById('icon-' + id);
            
            if (children.classList.contains('collapsed')) {
                children.classList.remove('collapsed');
                icon.classList.remove('fa-chevron-right');
                icon.classList.add('fa-chevron-down');
            } else {
                children.classList.add('collapsed');
                icon.classList.remove('fa-chevron-down');
                icon.classList.add('fa-chevron-right');
            }
        }
        
        function filterByStatus() {
            const selectedStatus = document.getElementById('statusFilter').value;
            const cards = document.querySelectorAll('.project-card');
            
            cards.forEach(card => {
                const cardStatus = card.getAttribute('data-workflow-status');
                
                if (!selectedStatus || cardStatus === selectedStatus) {
                    card.closest('.col-lg-4').style.display = '';
                } else {
                    card.closest('.col-lg-4').style.display = 'none';
                }
            });
        }
        
        // Force button styling on page load
        document.addEventListener('DOMContentLoaded', function() {
            const buttons = document.querySelectorAll('.btn-outline-theme-contexts');
            buttons.forEach(btn => {
                btn.style.color = '#8b5cf6';
                btn.style.borderColor = '#8b5cf6';
                btn.style.backgroundColor = 'transparent';
            });
        });
    </script>
    <script>
    // EMERGENCY FIX: Run immediately to fix cached grey buttons
    (function(){
        function fix() {
            document.querySelectorAll('button, a.btn').forEach(b => {
                var txt = b.textContent || '';
                if (txt.match(/Search|Import|Clear/) || b.getAttribute('onclick')?.match(/changeView|sortProjects/)) {
                    b.className = b.className.replace(/btn-outline-(secondary|primary|danger)/g, 'btn-outline-theme-contexts');
                    b.style.cssText = 'color:#8b5cf6!important;border:1px solid #8b5cf6!important;background:transparent!important';
                }
            });
        }
        fix();
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', fix);
        }
        setTimeout(fix, 50);
        setTimeout(fix, 200);
    })();
    </script>
}

<style>
    /* Board View Styles */
    .projects-board {
        margin-top: 1rem;
    }
    
    /* ULTRA SPECIFIC override for Bootstrap btn-outline-secondary */
    html body .container-fluid .btn.btn-outline-secondary[class*="flex-fill"],
