@model Compost.Contexts.ViewModels.GitSettingsViewModel

@{
    ViewBag.Title = "Git Credentials";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card shadow-sm mb-4" style="border-top: 4px solid var(--bs-primary);">
            <div class="card-header bg-transparent py-3">
                <h3 class="card-title mb-0">
                    <i class="fab fa-git-alt me-2 text-primary"></i>Git Credentials Settings
                </h3>
            </div>
            <div class="card-body p-4">
                <p class="text-muted mb-4">
                    Configure your global Git settings here. These credentials will be used when syncing your projects
                    if no project-specific credentials are provided. Your Personal Access Token (PAT) is stored securely
                    within the site settings.
                </p>

                <form asp-action="Edit" method="post" class="needs-validation">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-4">
                        <label asp-for="PersonalAccessToken" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            <input asp-for="PersonalAccessToken" type="password" class="form-control" placeholder="ghp_xxxxxxxxxxxx" value="@Model.PersonalAccessToken" />
                            <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <div class="form-text mt-1 text-muted small">
                            Recommended: Use a GitHub Personal Access Token with <code>repo</code> scope.
                        </div>
                        <span asp-validation-for="PersonalAccessToken" class="text-danger"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="AuthorName" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input asp-for="AuthorName" class="form-control" />
                            </div>
                            <span asp-validation-for="AuthorName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AuthorEmail" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input asp-for="AuthorEmail" class="form-control" />
                            </div>
                            <span asp-validation-for="AuthorEmail" class="text-danger"></span>
                        </div>
                    </div>

                    <hr class="my-4 opacity-10" />

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="@Url.Action("GitDashboard", "Project")" class="btn btn-link text-muted text-decoration-none">
                            <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                        </a>
                        <button type="submit" class="btn btn-primary px-5 py-2">
                            <i class="fas fa-save me-2"></i>Save Git Settings
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="alert alert-info border-0 shadow-sm">
            <div class="d-flex">
                <div class="me-3 fs-3 text-info">
                    <i class="fas fa-info-circle"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Why do I need these?</h6>
                    <p class="mb-0 small text-muted">
                        These credentials allow your Compost Assistant to securely communicate with your remote repositories.
                        For GitHub, go to <strong>Settings > Developer settings > Personal access tokens > Tokens (classic)</strong> to create a new token.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --bs-primary: #3b82f6; /* Modern Blue */
    }
    
    .btn-primary {
        background-color: var(--bs-primary);
        border-color: var(--bs-primary);
        box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.2);
        transition: all 0.2s ease;
    }
    
    .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3);
        background-color: #2563eb;
    }
    
    .input-group-text {
        background-color: transparent;
        color: var(--bs-primary);
        border-right: none;
    }
    
    .form-control {
        border-left: none;
    }
    
    .form-control:focus {
        border-color: #dee2e6;
        box-shadow: none;
        background-color: rgba(59, 130, 246, 0.03);
    }
</style>

<script>
    document.getElementById('togglePassword').addEventListener('click', function (e) {
        const password = document.getElementById('PersonalAccessToken') || document.querySelector('input[type="password"]');
        const icon = this.querySelector('i');
        
        if (password.type === 'password') {
            password.type = 'text';
            icon.classList.remove('fas fa-eye');
            icon.classList.add('fas fa-eye-slash');
        } else {
            password.type = 'password';
            icon.classList.remove('fas fa-eye-slash');
            icon.classList.add('fas fa-eye');
        }
    });
</script>
