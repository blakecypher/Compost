@{
    var title = ViewBag.Title ?? nameof(Compost);
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Prevent FOUC - set background color before CSS loads -->
    <style>
        html { background-color: #f9f5d7; }
        body { background-color: #f9f5d7 !important; visibility: hidden; }
        body.css-loaded { visibility: visible; }
    </style>
    
    <title>@title - Compost</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <style>
        /* Gruvbox Palette Definition */
        :root, [data-bs-theme="light"] {
            --gruv-bg: #f9f5d7;  /* Darker than original for better contrast */
            --gruv-bg-soft: #ebdbb2;
            --gruv-fg: #282828;  /* Much darker text */
            --gruv-fg-alt: #3c3836;
            --gruv-red: #9d0006;
            --gruv-green: #79740e;
            --gruv-yellow: #b57614;
            --gruv-blue: #076678;
            --gruv-purple: #8f3f71;
            --gruv-aqua: #427b58;
            --gruv-orange: #af3a03;
            --gruv-gray: #665c54;

            /* Bootstrap Overrides */
            --bs-body-bg: var(--gruv-bg);
            --bs-body-color: var(--gruv-fg);
            --bs-primary: var(--gruv-green);
            --bs-secondary: var(--gruv-gray);
            --bs-success: var(--gruv-aqua);
            --bs-info: var(--gruv-blue);
            --bs-warning: var(--gruv-yellow);
            --bs-danger: var(--gruv-red);
            --bs-dark: var(--gruv-fg);
            --bs-light: var(--gruv-bg-soft);

            /* Custom Components */
            --sidebar-bg: var(--gruv-bg-soft);
            --card-bg: #fdf6e3;
            --border-color: #d5c4a1;

            /* Module Theme Colors */
            --theme-contexts: #7c3aed;    /* Electric Violet */
            --theme-patterns: #7c3aed;   /* Electric Violet */
            --theme-snippets: #ab3e53;   /* Slate Grey */
        }

        [data-bs-theme="dark"] {
            --gruv-bg: #282828;
            --gruv-bg-soft: #32302f;
            --gruv-fg: #ebdbb2;
            --gruv-fg-alt: #d5c4a1;
            --gruv-red: #fb4934;
            --gruv-green: #b8bb26;
            --gruv-yellow: #fabd2f;
            --gruv-blue: #83a598;
            --gruv-purple: #d3869b;
            --gruv-aqua: #8ec07c;
            --gruv-orange: #fe8019;
            --gruv-gray: #a89984;

            /* Bootstrap Overrides */
            --bs-body-bg: var(--gruv-bg);
            --bs-body-color: var(--gruv-fg);
            --bs-primary: var(--gruv-green);
            --bs-secondary: var(--gruv-gray);
            --bs-success: var(--gruv-aqua);
            --bs-info: var(--gruv-blue);
            --bs-warning: var(--gruv-yellow);
            --bs-danger: var(--gruv-red);
            --bs-dark: var(--gruv-bg-soft);
            --bs-light: var(--gruv-fg); /* Inverted for text on dark */

            /* Custom Components */
            --sidebar-bg: var(--gruv-bg-soft);
            --card-bg: #3c3836;
            --border-color: #504945;

            /* Module Theme Colors - Dark */
            --theme-contexts: #8b5cf6;   /* Vibrant Purple */
            --theme-patterns: #8b5cf6;  /* Vibrant Purple */
            --theme-snippets: #9ca3af;  /* Light Slate */
            --bg-gradient-card: var(--card-bg);
        }

        /* Global Styles */
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: var(--bs-body-bg) !important; color: var(--bs-body-color) !important; }
        
        .navbar { background-color: var(--gruv-green) !important; color: #fbf1c7 !important; }
        .navbar-brand, .nav-link { color: #fbf1c7 !important; }
        .navbar-toggler { border-color: rgba(251, 241, 199, 0.5); }
        .navbar-toggler-icon { filter: invert(90%); }

        /* Sidebar Transitions & Premium Animations */
        .sidebar { 
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.3s ease; 
            width: 260px;
            /* overflow-x replaced for sticky support */
            background-color: var(--sidebar-bg) !important; 
            border-right: 1px solid var(--border-color) !important;
            z-index: 100;
        }
        
        .sidebar.collapsed {
            width: 72px;
        }

        .sidebar .nav-link { 
            color: var(--bs-body-color); 
            font-weight: 500; 
            white-space: nowrap;
            display: flex;
            align-items: center;
            overflow: hidden;
            padding: 0.8rem 1.25rem;
            border-radius: 0;
            transition: all 0.2s ease;
        }

        .sidebar .nav-link i {
            min-width: 24px;
            font-size: 1.1rem;
            margin-right: 1rem;
        }

        .sidebar .nav-link span {
            opacity: 1;
            transition: opacity 0.2s ease;
        }

        .sidebar.collapsed .nav-link span,
        .sidebar.collapsed .menu-section {
            opacity: 0;
            pointer-events: none;
        }

        .sidebar.collapsed .nav-link i {
            margin-right: 2rem; /* Keep icon positioned well when collapsed */
        }

        /* Shift main content smoothly */
        main {
            transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            flex-grow: 1;
            min-height: calc(100vh - 56px);
            min-width: 0;
            overflow-x: hidden;
        }

        /* Toggle Button Styling */
        #sidebarToggle {
            cursor: pointer;
            padding: 0.5rem;
            color: #fbf1c7;
            border: none;
            background: transparent;
            font-size: 1.2rem;
            margin-right: 0.5rem;
            transition: transform 0.3s ease;
        }
        
        #sidebarToggle:hover {
            opacity: 0.8;
        }

        .sidebar-sticky {
            position: sticky;
            top: 0;
            height: calc(100vh - 56px);
            padding-top: .5rem;
            overflow-x: hidden;
            overflow-y: auto;
        }
        
        /* Stats Widget visibility */
        .sidebar.collapsed .context-stats-widget {
            display: none !important;
        }
        
        /* ... rest of the existing styles ... */
        
        /* Contexts/Projects - Purple */
        .sidebar .nav-link[href*="Projects"]:hover,
        .sidebar .nav-link[href*="Contexts"]:hover,
        .sidebar .nav-link[href*="TreeView"]:hover { 
            background-color: rgba(124, 58, 237, 0.1) !important; 
            color: var(--theme-contexts) !important;
        }
        .sidebar .nav-link[href*="Projects"].active,
        .sidebar .nav-link[href*="Contexts"].active,
        .sidebar .nav-link[href*="TreeView"].active { 
            background-color: var(--theme-contexts) !important; 
            color: #fff !important;
            box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3) !important;
        }
        
        /* Patterns - Purple */
        .sidebar .nav-link[href*="Patterns"]:hover { 
            background-color: rgba(124, 58, 237, 0.1) !important; 
            color: var(--theme-patterns) !important;
        }
        .sidebar .nav-link[href*="Patterns"].active { 
            background-color: var(--theme-patterns) !important; 
            color: #fff !important;
        }
        
        /* Snippets - Slate */
        .sidebar .nav-link[href*="Snippets"]:hover { 
            background-color: rgba(108, 117, 125, 0.15) !important; 
            color: var(--theme-snippets) !important;
        }
        .sidebar .nav-link[href*="Snippets"].active { 
            background-color: var(--theme-snippets) !important; 
            color: #fff !important;
        }
        
        .sidebar .menu-section { 
            font-size: 0.65rem; 
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.1em; 
            color: var(--gruv-gray); 
            padding: 1.5rem 1.25rem 0.5rem;
            white-space: nowrap;
            transition: opacity 0.2s ease;
        }

        .card { background-color: var(--card-bg); border: 1px solid var(--border-color); }
        .card-header { background-color: rgba(0,0,0,0.03); border-bottom: 1px solid var(--border-color); font-weight: bold; }
        .card-footer { border-top: 1px solid var(--border-color); background-color: rgba(0,0,0,0.03); }

        .btn-primary { background-color: var(--gruv-green); border-color: var(--gruv-green); color: #fbf1c7; }
        .btn-primary:hover { background-color: var(--gruv-aqua); border-color: var(--gruv-aqua); color: #282828; }
        
        .btn-outline-primary { color: var(--gruv-green); border-color: var(--gruv-green); }
        .btn-outline-primary:hover { background-color: var(--gruv-green); color: #fbf1c7; }

        /* Force overrides for bootstrap utilities */
        .bg-light { background-color: var(--gruv-bg-soft) !important; }
        [data-bs-theme="dark"] .card { background-color: var(--card-bg) !important; border-color: #373b3e; }
        .bg-white { background-color: var(--card-bg) !important; }
        .text-dark { color: var(--gruv-fg) !important; }
        .text-muted { color: var(--gruv-gray) !important; }
        .border { border-color: var(--border-color) !important; }
        
        .table { --bs-table-bg: transparent; --bs-table-color: var(--gruv-fg); --bs-table-border-color: var(--border-color); }
        .table-light { --bs-table-bg: var(--gruv-bg-soft); --bs-table-color: var(--gruv-fg); }
        
        /* Form Controls - Better contrast for light theme */
        [data-bs-theme="light"] .form-control {
            background-color: #fdf6e3;
            border-color: #d5c4a1;
            color: #282828;
        }
        
        [data-bs-theme="light"] .form-control:focus {
            background-color: #fdf6e3;
            border-color: var(--gruv-green);
            color: #282828;
            box-shadow: 0 0 0 0.2rem rgba(121, 116, 14, 0.25);
        }
        
        [data-bs-theme="light"] .form-select {
            background-color: #fdf6e3;
            border-color: #d5c4a1;
            color: #282828;
        }
        
        [data-bs-theme="light"] .form-select:focus {
            background-color: #fdf6e3;
            border-color: var(--gruv-green);
            color: #282828;
            box-shadow: 0 0 0 0.2rem rgba(121, 116, 14, 0.25);
        }
        
        /* Fix Monaco Editor Border in Dark Mode */
        [data-bs-theme="dark"] .monaco-editor { border-color: #504945 !important; }

        /* Module Theme Utilities - ENHANCED SPECIFICITY */
        .bg-theme-contexts  { background-color: var(--theme-contexts) !important; }
        .bg-theme-patterns  { background-color: var(--theme-patterns) !important; }
        .bg-theme-snippets  { background-color: var(--theme-snippets) !important; }
        .text-theme-contexts  { color: var(--theme-contexts) !important; }
        .text-theme-patterns  { color: var(--theme-patterns) !important; }
        .text-theme-snippets  { color: var(--theme-snippets) !important; }
        .text-on-theme-contexts, .text-on-theme-patterns, .text-on-theme-snippets { color: #fff !important; }
        
        /* Button styles with ULTRA high specificity to override Bootstrap */
        body .btn.btn-theme-contexts { 
            background-color: var(--theme-contexts) !important; 
            border-color: var(--theme-contexts) !important; 
            color: #fff !important; 
        }
        body .btn.btn-theme-contexts:hover { 
            filter: brightness(1.12); 
            color: #fff !important; 
        }
        
        body .btn.btn-outline-theme-contexts { 
            background-color: transparent !important; 
            border-color: var(--theme-contexts) !important; 
            color: var(--theme-contexts) !important; 
        }
        body .btn.btn-outline-theme-contexts:hover { 
            background-color: var(--theme-contexts) !important; 
            color: #fff !important; 
        }
        
        .btn.btn-theme-snippets { 
            background-color: var(--theme-snippets) !important; 
            border-color: var(--theme-snippets) !important; 
            color: #fff !important; 
        }
        .btn.btn-theme-snippets:hover { 
            filter: brightness(1.12); 
            color: #fff !important; 
        }
        
        .btn.btn-outline-theme-patterns { 
            background-color: transparent !important; 
            border-color: var(--theme-patterns) !important; 
            color: var(--theme-patterns) !important; 
        }
        .btn.btn-outline-theme-patterns:hover { 
            background-color: var(--theme-patterns) !important; 
            color: #fff !important; 
        }
        
        .btn.btn-theme-patterns { 
            background-color: var(--theme-patterns) !important; 
            border-color: var(--theme-patterns) !important; 
            color: #fff !important; 
        }
        .btn.btn-theme-patterns:hover { 
            filter: brightness(1.12); 
            color: #fff !important; 
        }
        
        .border-theme-contexts { border-color: var(--theme-contexts) !important; }
        .border-theme-patterns { border-color: var(--theme-patterns) !important; }
        .border-theme-snippets { border-color: var(--theme-snippets) !important; }
        .badge.bg-theme-contexts { background-color: var(--theme-contexts) !important; }
        .badge.bg-theme-patterns { background-color: var(--theme-patterns) !important; }
        .badge.bg-theme-snippets { background-color: var(--theme-snippets) !important; }
        /* Dark Mode Sidebar Nav Color Reset */
        [data-bs-theme="dark"] .sidebar .nav-link.active {
            background-color: rgba(255, 255, 255, 0.08) !important;
            box-shadow: none !important;
        }
        [data-bs-theme="dark"] .sidebar .nav-link.active.bg-theme-dashboard { color: var(--theme-dashboard, #198754) !important; }
        [data-bs-theme="dark"] .sidebar .nav-link.active.bg-theme-contexts { color: var(--theme-contexts, #6629d9) !important; }
        [data-bs-theme="dark"] .sidebar .nav-link.active.bg-theme-mindmaps { color: var(--theme-mindmaps, #ff6b35) !important; }
        [data-bs-theme="dark"] .sidebar .nav-link.active.bg-theme-kanban { color: var(--theme-kanban, #ffc107) !important; }
        [data-bs-theme="dark"] .sidebar .nav-link.active.bg-theme-transcription { color: var(--theme-transcription, #68a073) !important; }
        [data-bs-theme="dark"] .sidebar .nav-link.active.bg-theme-snippets { color: var(--theme-snippets, #943a3a) !important; }
        [data-bs-theme="dark"] .sidebar .nav-link.active.bg-theme-patterns { color: var(--theme-patterns, #6629d9) !important; }
        [data-bs-theme="dark"] .sidebar .nav-link.active.bg-primary { color: var(--bs-primary, #0d6efd) !important; }
        
        .sidebar .nav-link.active i, .sidebar .nav-link:hover i {
            color: inherit !important;
        }
        /* h1 Color Strip & Icon Retention */
        h1.text-theme-dashboard, h1.text-theme-contexts, h1.text-theme-mindmaps, 
        h1.text-theme-kanban, h1.text-theme-transcription, h1.text-theme-snippets, 
        h1.text-theme-patterns, h1.text-primary, h1.text-transcription, h1.text-success, h1.text-danger { 
            color: var(--bs-body-color) !important; 
        }
        h1.text-theme-dashboard i { color: var(--theme-dashboard, #198754) !important; }
        h1.text-theme-contexts i { color: var(--theme-contexts, #6629d9) !important; }
        h1.text-theme-mindmaps i { color: var(--theme-mindmaps, #ff6b35) !important; }
        h1.text-theme-kanban i { color: var(--theme-kanban, #ffc107) !important; }
        h1.text-theme-transcription i, h1.text-transcription i { color: var(--theme-transcription, #68a073) !important; }
        h1.text-theme-snippets i { color: var(--theme-snippets, #f87171) !important; }
        h1.text-theme-patterns i { color: var(--theme-patterns, #a855f7) !important; }
        h1.text-primary i { color: var(--bs-primary, #0d6efd) !important; }
        h1.text-success i { color: var(--bs-success, #198754) !important; }
        h1.text-danger i { color: var(--bs-danger, #dc3545) !important; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-body-tertiary">
    <script>document.body.classList.add('css-loaded');</script>
    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm sticky-top" style="z-index: 1040;">
        <div class="container-fluid">
            <div class="d-flex align-items-center">
                <button id="sidebarToggle" title="Toggle Sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <a class="navbar-brand fw-bold" href="~/">
                    <i class="fas fa-leaf me-2"></i>Compost
                </a>
            </div>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link px-3 text-white-50" id="themeToggle" href="#" title="Toggle Dark/Light Mode">
                            <i class="fas fa-moon"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/"><i class="fas fa-home me-1"></i>Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/Admin"><i class="fas fa-cog me-1"></i>Admin</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/Projects/GitSettings/Edit"><i class="fas fa-key me-1"></i>Git Settings</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid p-0">
        <div class="d-flex">
            <!-- Left Sidebar Menu -->
            <nav id="sidebar" class="sidebar flex-shrink-0 pt-3">
                <div class="sidebar-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path == "/" ? "active" : "")" href="~/">
                                <i class="fas fa-tachometer-alt"></i><span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item"><span class="menu-section">Workflow</span></li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/List") ? "active" : "")" href="/Projects/List">
                                <i class="fas fa-folder-open"></i><span>Projects</span>
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/Projects/Create") ? "active" : "")" href="/Projects/Create">
                                <i class="fas fa-plus-circle"></i><span>Create Context</span>
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/MindMap") ? "active" : "")" href="/MindMap">
                                <i class="fas fa-brain"></i><span>Mind Maps</span>
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().StartsWith("/Kanban") ? "active" : "")" href="/Kanban">
                                <i class="fas fa-columns"></i><span>Kanban Board</span>
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/GitDashboard") ? "active" : "")" href="/Projects/GitDashboard">
                                <i class="fab fa-git-alt"></i><span>Git</span>
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/TreeView") ? "active" : "")" href="/Contexts/TreeView">
                                <i class="fas fa-sitemap"></i><span>Tree View</span>
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/Transcription") ? "active" : "")" href="/Transcription">
                                <i class="fas fa-microphone"></i><span>Transcription</span>
                            </a>
                        </li>
                        <li class="nav-item"><span class="menu-section">Library</span></li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/Snippets") ? "active" : "")" href="/Snippets">
                                <i class="fas fa-code"></i><span>Snippets</span>
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link @(Context.Request.Path.ToString().Contains("/Patterns") ? "active" : "")" href="/Patterns">
                                <i class="fas fa-project-diagram"></i><span>Patterns</span>
                            </a>
                        </li>
                    </ul>

                    <!-- Quick Stats Widget -->
                    <div class="context-stats-widget px-3 mt-4">
                        @await Component.InvokeAsync("ContextStats")
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <main id="main-content" class="px-md-4 py-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <i class="fas fa-info-circle me-2 text-success" id="toastIcon"></i>
                <strong class="me-auto" id="toastTitle">Notification</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body" id="toastMessage">
                Action completed successfully.
            </div>
        </div>
    </div>

    <!-- jQuery (Required for Validation) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Common JS Utilities -->
    <script>
        // Global Toast Helper
        function showToast(message, title = 'Notification', type = 'success') {
            try {
                const toastEl = document.getElementById('liveToast');
                if (!toastEl) return;
                
                document.getElementById('toastMessage').textContent = message;
                document.getElementById('toastTitle').textContent = title;
                const icon = document.getElementById('toastIcon');
                
                if (type === 'danger') {
                    icon.className = 'fas fa-exclamation-circle me-2 text-danger';
                } else if (type === 'warning') {
                    icon.className = 'fas fa-exclamation-triangle me-2 text-warning';
                } else {
                    icon.className = 'fas fa-check-circle me-2 text-success';
                }

                const toast = new bootstrap.Toast(toastEl);
                toast.show();
            } catch (e) {
                console.error('Toast failed:', e);
            }
        }

        // Theme Toggle Support
        const themeToggle = document.getElementById('themeToggle');
        const html = document.documentElement;
        
        // Load saved theme
        const savedTheme = localStorage.getItem('theme') || 'light';
        html.setAttribute('data-bs-theme', savedTheme);
        if (themeToggle) updateToggleIcon(savedTheme);

        if (themeToggle) {
            themeToggle.addEventListener('click', (e) => {
                e.preventDefault();
                const currentTheme = html.getAttribute('data-bs-theme');
                const newTheme = currentTheme === 'light' ? 'dark' : 'light';
                
                html.setAttribute('data-bs-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                updateToggleIcon(newTheme);
            });
        }

        function updateToggleIcon(theme) {
            const icon = themeToggle?.querySelector('i');
            if (!icon) return;
            if (theme === 'dark') {
                icon.className = 'fas fa-sun';
            } else {
                icon.className = 'fas fa-moon';
            }
        }

        // SIDEBAR TOGGLE ENGINE
        const sidebar = document.getElementById('sidebar');
        const sidebarToggle = document.getElementById('sidebarToggle');
        
        // Initial state from localStorage
        const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
        if (isCollapsed) {
            sidebar.classList.add('collapsed');
        }

        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', () => {
                sidebar.classList.toggle('collapsed');
                const nowCollapsed = sidebar.classList.contains('collapsed');
                localStorage.setItem('sidebarCollapsed', nowCollapsed);
                
                // Trigger resize event for components that need it (like mind maps or charts)
                window.dispatchEvent(new Event('resize'));
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
