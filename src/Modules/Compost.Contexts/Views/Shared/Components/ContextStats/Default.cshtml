@model Compost.Contexts.ViewComponents.ContextStatsViewModel

<div class="mt-4 p-3 rounded" style="background: var(--bs-body-bg); border: 1px solid var(--bs-border-color);">
    <h6 class="text-muted text-uppercase mb-3" style="font-size: 0.75rem; letter-spacing: 0.5px;">Quick Stats</h6>
    
    <!-- Total Contexts -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <small class="text-muted">Total Projects</small>
        <span class="badge" style="background: var(--theme-contexts);">@Model.TotalContexts</span>
    </div>
    
    <!-- Active Contexts -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <small class="text-muted"><i class="fas fa-circle me-1" style="color: var(--bs-success); font-size: 0.5rem;"></i>Active</small>
        <span class="badge" style="background: var(--bs-success);">@Model.ActiveContexts</span>
    </div>
    
    <!-- Tracking -->
    @if (Model.TrackingContexts > 0)
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <small class="text-muted"><i class="fas fa-clock me-1" style="color: var(--bs-warning);"></i>Tracking</small>
            <span class="badge" style="background: var(--bs-warning); color: #000;">@Model.TrackingContexts</span>
        </div>
    }
    
    <!-- Status Breakdown -->
    @if (Model.StatusCounts.Any())
    {
        <hr class="my-2" />
        <small class="text-muted d-block mb-2">By Status</small>
        @foreach (var status in Model.StatusCounts.OrderByDescending(s => s.Value))
        {
            var badgeStyle = status.Key switch
            {
                "Done" => "background: var(--bs-success);",
                "In Progress" => "background: var(--bs-info);",
                "Blocked" => "background: var(--bs-danger);",
                "To Do" => "background: var(--bs-secondary);",
                _ => "background: var(--bs-secondary);"
            };
            <div class="d-flex justify-content-between align-items-center mb-1">
                <small class="text-muted" style="font-size: 0.7rem;">@status.Key</small>
                <span class="badge" style="@badgeStyle font-size: 0.65rem;">@status.Value</span>
            </div>
        }
    }
    
    <!-- Total Time -->
    <hr class="my-2" />
    <div class="text-center">
        <small class="text-muted d-block">Total Time</small>
        <span class="fw-bold" style="color: var(--theme-contexts);">@($"{Model.TotalTimeSpent.TotalHours:F1}h")</span>
    </div>
</div>
