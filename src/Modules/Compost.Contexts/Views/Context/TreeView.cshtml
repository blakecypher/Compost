<script>
    function copyProjectLink(projectId) {
        const url = window.location.origin + '/Contexts/TreeView#' + projectId;
        navigator.clipboard.writeText(url).then(() => {
            // Show success feedback
            const button = event.target.closest('button');
            const originalHtml = button.innerHTML;
            button.innerHTML = '<i class="fas fa-check"></i>';
            button.classList.add('btn-success');
            button.classList.remove('btn-outline-theme-contexts');
            
            setTimeout(() => {
                button.innerHTML = originalHtml;
                button.classList.remove('btn-success');
                button.classList.add('btn-outline-theme-contexts');
            }, 2000);
        });
    }
    
    function importSampleProjects() {
        // This could be expanded to actually import sample projects
        alert('Sample project import would be implemented here. For now, click "Create Project" to get started.');
    }
    
    function changeView(viewType) {
        const boardView = document.getElementById('projectsBoard');
        const treeView = document.getElementById('treeView');
        const boardBtn = document.querySelector('[onclick="changeView(\'board\')"]');
        const treeBtn = document.querySelector('[onclick="changeView(\'tree\')"]');
        
        if (viewType === 'board') {
            if (boardView) boardView.style.display = 'block';
            if (treeView) treeView.style.display = 'none';
            if (boardBtn) boardBtn.classList.add('active');
            if (treeBtn) treeBtn.classList.remove('active');
        } else {
            if (boardView) boardView.style.display = 'none';
            if (treeView) treeView.style.display = 'block';
            if (boardBtn) boardBtn.classList.remove('active');
            if (treeBtn) treeBtn.classList.add('active');
        }
    }
    
    function viewProjectDetails(projectId) {
        window.location.href = '/Compost.Contexts/Project/Edit/' + projectId;
    }
    
    function toggleChildren(projectId) {
        // This would toggle visibility of child projects in tree view
        console.log('Toggle children for project:', projectId);
    }
    
    function filterByStatus() {
        const selectedStatus = document.getElementById('statusFilter').value;
        const cards = document.querySelectorAll('.project-card');
        
        cards.forEach(card => {
            const cardStatus = card.getAttribute('data-workflow-status');
            
            if (!selectedStatus || cardStatus === selectedStatus) {
                card.closest('.col-lg-4').style.display = '';
            } else {
                card.closest('.col-lg-4').style.display = 'none';
            }
        });
    }
</script>
