@model Compost.Contexts.ViewModels.CreateContextViewModel

@{
    ViewBag.Title = "Create Project";
}

<div class="container-fluid">
    <h1>Create New Project</h1>
    <p class="lead">Set up a new project context to track time and manage your workspace.</p>

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Create" asp-controller="Project" method="post">
                @Html.AntiForgeryToken()
                
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g., Project Alpha Bug Fix" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of what you're working on..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="card mb-3">
                    <div class="card-header">
                        <i class="fa fa-github"></i> Repository Information (Optional)
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="RepositoryName" class="form-label"></label>
                            <input asp-for="RepositoryName" class="form-control" placeholder="e.g., my-project" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="RepositoryUrl" class="form-label"></label>
                            <input asp-for="RepositoryUrl" class="form-control" placeholder="https://github.com/user/repo" />
                            <span asp-validation-for="RepositoryUrl" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CurrentBranch" class="form-label"></label>
                            <input asp-for="CurrentBranch" class="form-control" placeholder="e.g., feature/new-feature" />
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Tags" class="form-label"></label>
                    <input asp-for="Tags" class="form-control" placeholder="e.g., bugfix, urgent, frontend (comma-separated)" />
                    <div class="form-text">Separate tags with commas</div>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="To Do">To Do</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Done">Done</option>
                        <option value="Blocked">Blocked</option>
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="ParentContextId" class="form-label"></label>
                            <select asp-for="ParentContextId" class="form-select">
                                <option value="">(None - Root Project)</option>
                                @foreach (var context in ViewBag.AllContexts as List<Compost.Core.Models.Project> ?? [])
                                {
                                    <option value="@context.Id">@context.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="DisplayOrder" class="form-label"></label>
                            <input asp-for="DisplayOrder" type="number" class="form-control" value="0" />
                            <div class="form-text">Lower numbers appear first in lists</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Create Project
                    </button>
                    <a asp-action="TreeView" asp-controller="Project" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
