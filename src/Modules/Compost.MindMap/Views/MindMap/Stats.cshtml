@model Compost.MindMap.ViewModels.MindMapStatsViewModel

@{
    ViewBag.Title = $"Statistics - {Model.MindMapName}";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="text-theme-mindmaps">
                        <i class="fas fa-chart-bar me-2"></i>Mind Map Statistics
                    </h1>
                    <p class="text-muted mb-0">@Model.MindMapName</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="ViewMap" asp-route-id="@Model.MindMapId" class="btn btn-outline-primary">
                        <i class="fas fa-project-diagram me-1"></i>View Map
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Overview Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h1 class="display-4">@Model.TotalNodes</h1>
                    <p class="mb-0">Total Nodes</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h1 class="display-4">@Model.RootNodes</h1>
                    <p class="mb-0">Root Nodes</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h1 class="display-4">@Model.LeafNodes</h1>
                    <p class="mb-0">Leaf Nodes</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body text-center">
                    <h1 class="display-4">@Model.MaxDepth</h1>
                    <p class="mb-0">Max Depth</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Nodes by Type -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-pie-chart me-2"></i>Nodes by Type</h5>
                </div>
                <div class="card-body">
                    @if (Model.NodesByType.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var type in Model.NodesByType.OrderByDescending(x => x.Value))
                            {
                                var percentage = (double)type.Value / Model.TotalNodes * 100;
                                var badgeColor = type.Key switch
                                {
                                    "Root" => "#2c5f2d",
                                    "Idea" => "#4a7c4b",
                                    "Requirement" => "#2196f3",
                                    "Question" => "#ff9800",
                                    "Action" => "#9c27b0",
                                    "Decision" => "#4caf50",
                                    "Risk" => "#f44336",
                                    "Note" => "#757575",
                                    _ => "#97bc62"
                                };
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>
                                        <span class="badge me-2" style="background-color: @badgeColor;">@type.Key</span>
                                    </span>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="progress flex-grow-1" style="width: 100px;">
                                            <div class="progress-bar" role="progressbar" style="width: @percentage%;"></div>
                                        </div>
                                        <span class="badge bg-secondary">@type.Value</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center mb-0">No node type data available</p>
                    }
                </div>
            </div>
        </div>

        <!-- Top Tags -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-tags me-2"></i>Top Tags</h5>
                </div>
                <div class="card-body">
                    @if (Model.TopTags.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var tag in Model.TopTags)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span><i class="fas fa-tag me-2 text-muted"></i>@tag.Key</span>
                                    <span class="badge bg-primary">@tag.Value uses</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center mb-0">No tags used in this mind map</p>
                    }
                    <div class="mt-3 text-center">
                        <small class="text-muted">Total unique tags: <strong>@Model.TotalTags</strong></small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Structure Analysis -->
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-sitemap me-2"></i>Structure Analysis</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <tbody>
                            <tr>
                                <td>Average Children per Node</td>
                                <td class="text-end"><strong>@Model.AverageChildrenPerNode.ToString("F2")</strong></td>
                            </tr>
                            <tr>
                                <td>Branching Factor</td>
                                <td class="text-end"><strong>@((Model.TotalNodes - Model.RootNodes) / Math.Max(1, Model.TotalNodes - Model.LeafNodes))</strong></td>
                            </tr>
                            <tr>
                                <td>Created</td>
                                <td class="text-end">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <td>Last Updated</td>
                                <td class="text-end">@Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
