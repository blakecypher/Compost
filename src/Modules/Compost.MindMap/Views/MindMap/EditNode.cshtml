@using Compost.MindMap.Models
@model Compost.MindMap.ViewModels.MindMapNodeViewModel

@{
    ViewBag.Title = "Edit Node";
    var existingNodes = ViewBag.ExistingNodes as List<MindMapNode>;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="text-theme-mindmaps">
                        <i class="fas fa-edit me-2"></i>Edit Node
                    </h2>
                    <p class="text-muted">Editing node in mind map: <strong>@ViewBag.MindMapName</strong></p>
                </div>
                <a asp-action="ViewMap" asp-route-id="@Model.MindMapId" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Back to Map
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-project-diagram me-2"></i>Node Details</h5>
                </div>
                <div class="card-body">
                    <form asp-action="EditNode" asp-route-id="@Model.MindMapId" method="post">
                        <input type="hidden" asp-for="MindMapId" />
                        <input type="hidden" asp-for="NodeId" />

                        <div class="mb-3">
                            <label asp-for="Text" class="form-label">Node Text <span class="text-danger">*</span></label>
                            <input asp-for="Text" class="form-control" placeholder="Enter node text..." />
                            <span asp-validation-for="Text" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="NodeType" class="form-label">Node Type <span class="text-danger">*</span></label>
                                    <select asp-for="NodeType" class="form-select">
                                        <option value="Idea">💡 Idea</option>
                                        <option value="Requirement">📋 Requirement</option>
                                        <option value="Question">❓ Question</option>
                                        <option value="Action">⚡ Action</option>
                                        <option value="Decision">✅ Decision</option>
                                        <option value="Risk">⚠️ Risk</option>
                                        <option value="Note">📝 Note</option>
                                    </select>
                                    <span asp-validation-for="NodeType" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ParentNodeId" class="form-label">Parent Node (Optional)</label>
                                    <select asp-for="ParentNodeId" class="form-select">
                                        <option value="">-- Root Level --</option>
                                        @foreach (var node in existingNodes ?? [])
                                        {
                                            <option value="@node.Id">@node.Text (@node.NodeType)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="PositionX" class="form-label">Position X</label>
                                    <input asp-for="PositionX" type="number" class="form-control" step="10" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="PositionY" class="form-label">Position Y</label>
                                    <input asp-for="PositionY" type="number" class="form-control" step="10" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tags" class="form-label">Tags (comma-separated)</label>
                            <input asp-for="Tags" class="form-control" placeholder="tag1, tag2, tag3" />
                            <div class="form-text">Add tags to categorize this node</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SourceText" class="form-label">Source/Notes</label>
                            <textarea asp-for="SourceText" class="form-control" rows="3" placeholder="Additional context or source information..."></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-theme-mindmaps">
                                    <i class="fas fa-save me-1"></i>Save Changes
                                </button>
                                <a asp-action="ViewMap" asp-route-id="@Model.MindMapId" class="btn btn-outline-secondary">
                                    Cancel
                                </a>
                            </div>
                            <form asp-action="DeleteNode" asp-route-id="@Model.MindMapId" method="post" 
                                  onsubmit="return confirm('Are you sure you want to delete this node?');" class="d-inline">
                                <input type="hidden" name="nodeId" value="@Model.NodeId" />
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="fas fa-trash me-1"></i>Delete Node
                                </button>
                            </form>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Edit Tips</h5>
                </div>
                <div class="card-body">
                    <ul class="small text-muted">
                        <li class="mb-2">Changing the parent node will move this node in the hierarchy</li>
                        <li class="mb-2">Position X/Y controls where the node appears on the map</li>
                        <li class="mb-2">Tags help filter and categorize nodes</li>
                        <li class="mb-2">Source text can contain detailed notes or references</li>
                        <li class="mb-2 text-danger"><strong>Warning:</strong> Deleting a node will reassign its children to the parent</li>
                    </ul>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-palette me-2"></i>Type Colors</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled small">
                        <li class="mb-2"><span class="badge" style="background-color: #4a7c4b;">💡 Idea</span></li>
                        <li class="mb-2"><span class="badge" style="background-color: #2196f3;">📋 Requirement</span></li>
                        <li class="mb-2"><span class="badge" style="background-color: #ff9800;">❓ Question</span></li>
                        <li class="mb-2"><span class="badge" style="background-color: #9c27b0;">⚡ Action</span></li>
                        <li class="mb-2"><span class="badge" style="background-color: #4caf50;">✅ Decision</span></li>
                        <li class="mb-2"><span class="badge" style="background-color: #f44336;">⚠️ Risk</span></li>
                        <li class="mb-2"><span class="badge" style="background-color: #757575;">📝 Note</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
