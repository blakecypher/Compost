@using Compost.Patterns.Models
@using OrchardCore.ContentManagement
@model IEnumerable<ContentItem>

@{
    ViewData["Title"] = "Architectural Patterns";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-theme-patterns">
            <i class="fas fa-project-diagram"></i> Architectural Patterns
        </h2>
        <p class="text-muted">Document and reuse architectural decisions and design patterns.</p>
    </div>
    <a asp-action="Create" class="btn btn-theme-patterns">
        <i class="fas fa-plus"></i> Add Pattern
    </a>
</div>

<div class="card bg-light mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="input-group">
                <input type="text" name="query" class="form-control" placeholder="Search patterns by name, usage, description, or keywords..." value="@ViewBag.SearchQuery">
                <button class="btn btn-outline-secondary" type="submit">
                    <i class="fas fa-search"></i> Search
                </button>
                @if (ViewBag.SearchQuery != null)
                {
                    <a asp-action="Index" class="btn btn-outline-danger">
                        <i class="fas fa-times"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="row">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            var pattern = item.As<ArchitecturalPatternPart>();
            if (pattern == null) continue;
            
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-theme-patterns shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@item.DisplayText</h5>
                        <p class="card-text small text-muted">
                            @(pattern.WhenToUse?.Length > 150 ? pattern.WhenToUse[..150] + "..." : pattern.WhenToUse)
                        </p>
                        <div class="mt-3">
                            @if(pattern.Keywords != null)
                            {
                                @foreach(var tag in pattern.Keywords.Take(3))
                                {
                                    <span class="badge bg-theme-patterns text-on-theme-patterns me-1">@tag</span>
                                }
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 d-flex justify-content-between">
                         <a asp-action="Detail" asp-route-id="@item.ContentItemId" class="btn btn-sm btn-outline-theme-patterns">
                            <i class="fas fa-book-open"></i> View Details
                        </a>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-link text-theme-patterns" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-ellipsis-h"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a asp-action="Edit" asp-route-id="@item.ContentItemId" class="dropdown-item">Edit</a></li>
                                <li><a asp-action="Delete" asp-route-id="@item.ContentItemId" class="dropdown-item text-danger" onclick="return confirm('Are you sure?');">Delete</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-secondary text-center py-5">
                <i class="fas fa-layer-group fa-3x mb-3"></i>
                <h4>No Patterns Defined</h4>
                <p>Start documenting your architectural patterns to standardize your development.</p>
                <a asp-action="Create" class="btn btn-theme-patterns mt-2">Create Pattern</a>
            </div>
        </div>
    }
</div>
