@model Compost.Patterns.ViewModels.PatternViewModel

@{
    ViewBag.Title = "Edit Pattern";
}

<div class="container-fluid">
    <!-- Header matching Contexts style -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-theme-patterns" style="color: #a855f7 !important;">
                <i class="fas fa-edit me-2" style="color: #a855f7 !important;"></i>Edit Pattern
            </h1>
            <p class="text-muted mb-0">@Model.Title</p>
        </div>
        <a asp-action="Index" class="btn btn-theme-patterns" style="background-color: #a855f7 !important; border-color: #a855f7 !important; color: #fff !important;">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Edit" method="post" id="patternForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                
                <!-- Pattern Definition Card -->
                <div class="card pattern-enhanced-card mb-3">
                    <div class="card-header d-flex align-items-center pattern-header-background">
                        <div class="pattern-icon me-2">
                            <i class="fas fa-project-diagram text-theme-patterns"></i>
                        </div>
                        <span class="fw-bold">Pattern Definition</span>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Pattern Name</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Keywords" class="form-label fw-bold">Keywords (comma separated)</label>
                            <input asp-for="Keywords" class="form-control" />
                            <span asp-validation-for="Keywords" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="WhenToUse" class="form-label fw-bold">When to Use (Problem Statement)</label>
                            <textarea asp-for="WhenToUse" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="WhenToUse" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="HowItWorks" class="form-label fw-bold">How it Works (Solution)</label>
                            <textarea asp-for="HowItWorks" class="form-control" rows="5"></textarea>
                            <small class="text-muted">Markdown supported</small>
                            <span asp-validation-for="HowItWorks" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Gotchas" class="form-label fw-bold">Gotchas & Pitfalls</label>
                            <textarea asp-for="Gotchas" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Gotchas" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="ResourceUrlsText" class="form-label fw-bold">Resource URLs (one per line)</label>
                            <textarea asp-for="ResourceUrlsText" class="form-control" rows="2" placeholder="https://..."></textarea>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        
        <div class="col-md-4">
            <!-- Actions Card -->
            <div class="card pattern-enhanced-card mb-3">
                <div class="card-header d-flex align-items-center pattern-header-background">
                    <div class="pattern-icon me-2">
                        <i class="fas fa-cog text-theme-patterns"></i>
                    </div>
                    <span class="fw-bold">Actions</span>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button type="button" onclick="document.getElementById('patternForm').submit();" class="btn btn-success">
                            <i class="fas fa-save me-2"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i> Cancel
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
