<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>compost-web-secrets</UserSecretsId>
    <AllowRidSpecificRuntimeAssets>true</AllowRidSpecificRuntimeAssets>
  </PropertyGroup>

  <ItemGroup>
    <!-- Orchard Core CMS -->
    <PackageReference Include="OrchardCore.Application.Cms.Targets" Version="2.2.1" />
    <PackageReference Include="OrchardCore.Logging.NLog" Version="2.2.1" />
    <PackageReference Include="OrchardCore.Themes" Version="2.2.1" />
    
    <!-- Azure Services -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.25.0" />
    <PackageReference Include="Azure.AI.OpenAI" Version="1.0.0-beta.12" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.34.1" />
    
    <!-- Application Insights -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.21.0" />
    
    <!-- Security patch for transitive dependency -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference Core Business Logic -->
    <ProjectReference Include="..\Compost.Core\Compost.Core.csproj" />
    
    <!-- Reference Custom Modules -->
    <ProjectReference Include="..\Modules\Compost.Contexts\Compost.Contexts.csproj" />
    <ProjectReference Include="..\Modules\Compost.MindMap\Compost.MindMap.csproj" />
    <ProjectReference Include="..\Modules\Compost.Transcription\Compost.Transcription.csproj" />
    <ProjectReference Include="..\Modules\Compost.Kanban\Compost.Kanban.csproj" />
    <ProjectReference Include="..\Modules\Compost.Snippets\Compost.Snippets.csproj" />
    <ProjectReference Include="..\Modules\Compost.Patterns\Compost.Patterns.csproj" />
    <ProjectReference Include="..\Modules\Compost.Analytics\Compost.Analytics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\css\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\Sites\Default\appsettings.json" />
    <Content Include="App_Data\Sites\Default\yessql.db" />
  </ItemGroup>

</Project>
